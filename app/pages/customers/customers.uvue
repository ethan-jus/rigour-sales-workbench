<template>
  <scroll-view class="page" direction="vertical">
    <view class="content">
      <view class="heading-row"><text class="heading">客户</text><text class="count" v-if="session.authenticated">{{ commerce.customersTotal }} 位</text></view>
      <text class="intro">客户信息与供应链平台同步，按账号权限展示。</text>
      <view v-if="!session.authenticated" class="empty"><text class="empty-icon">◎</text><text class="empty-title">登录后查看客户</text><text class="empty-copy">使用供应链系统账号，继续客户跟进与下单。</text><button class="primary" @click="login">使用平台账号登录</button></view>
      <view v-else>
        <view class="search"><input class="search-input" v-model="query" placeholder="搜索客户名称" confirm-type="search" @confirm="search"/><button class="search-button" @click="search">搜索</button></view>
        <view class="scope"><text class="scope-label">可查看客户</text><text class="scope-description">范围由平台授权</text></view>
        <view v-if="commerce.customersError.length > 0" class="notice"><text class="notice-title">客户加载失败</text><text class="notice-copy">{{ commerce.customersError }}</text><button class="secondary" @click="search">重新加载</button></view>
        <view v-if="commerce.customersLoading && commerce.customers.length == 0" class="empty"><text class="empty-copy">正在加载客户…</text></view>
        <view v-for="customer in commerce.customers" :key="customer.id" class="customer-row" @click="openCustomer(customer)">
          <view class="avatar"><text class="avatar-text">客</text></view>
          <view class="customer-copy"><view class="row"><text class="customer-name">{{ customer.name }}</text><text class="chevron">›</text></view><text class="meta">{{ customer.contact.length > 0 ? customer.contact : '未填写联系人' }}{{ customer.phone.length > 0 ? ' · ' + customer.phone : '' }}</text><text class="address">{{ customer.address.length > 0 ? customer.address : '未填写地址' }}</text></view>
        </view>
        <view v-if="!commerce.customersLoading && commerce.customersError.length == 0 && commerce.customers.length == 0" class="empty"><text class="empty-icon">◎</text><text class="empty-title">{{ query.length > 0 ? '没有找到匹配客户' : '暂无可查看客户' }}</text><text class="empty-copy">{{ query.length > 0 ? '换个名称再搜索试试。' : '客户分配和数据权限由平台统一管理。' }}</text></view>
        <button v-if="commerce.customers.length < commerce.customersTotal" class="load-more" :disabled="commerce.customersLoading" @click="loadMore">{{ commerce.customersLoading ? '加载中…' : '加载更多客户' }}</button>
        <view v-if="drafts.length > 0" class="draft-section"><text class="section-title">继续购物草稿</text><view v-for="draft in drafts" :key="draft.customerId" class="draft-row" @click="openDraft(draft)"><view class="draft-copy"><text class="draft-name">{{ draft.customerName }}</text><text class="meta">{{ draft.lines.length }} 种商品 · 已保存在本机</text></view><text class="orange">继续 →</text></view></view>
      </view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
import { session, requireSession } from '../../services/session.uts'
import { commerce, loadCustomers, loadDrafts } from '../../services/commerce.uts'
import type { Customer, CartDraft } from '../../services/commerce.uts'
const query = ref('')
let owner = ''
const drafts = computed((): CartDraft[] => commerce.drafts.filter((draft: CartDraft): boolean => draft.lines.length > 0))
onShow(() => { loadDrafts(); const currentOwner = session.tenantId + ':' + session.userId; if (owner != currentOwner) { owner = currentOwner; query.value = '' }; if (session.authenticated) loadCustomers(query.value) })
function login(): void { requireSession() }
function search(): void { loadCustomers(query.value.trim()) }
function loadMore(): void { loadCustomers(query.value.trim(), true) }
function openCustomer(customer: Customer): void { uni.navigateTo({ url: '/pages/commerce/commerce?view=customer&id=' + encodeURIComponent(customer.id) }) }
function openDraft(draft: CartDraft): void { commerce.selectedCustomerId = draft.customerId; uni.navigateTo({ url: '/pages/commerce/commerce?view=cart' }) }
</script>
<style>
.page { flex: 1; background-color: #fffdf9; }
.content { padding: 22px; padding-bottom: 34px; }
.heading-row { flex-direction: row; align-items: center; justify-content: space-between; }
.heading { font-size: 28px; font-weight: bold; color: #21252b; }
.count { font-size: 12px; color: #85868b; }
.intro { font-size: 12px; color: #85868b; line-height: 20px; margin-top: 8px; margin-bottom: 22px; }
.search { flex-direction: row; background-color: #f3f2ee; border-radius: 10px; padding: 6px; align-items: center; }
.search-input { flex: 1; font-size: 14px; height: 40px; padding-left: 8px; color: #21252b; }
.search-button { color: #ffffff; background-color: #e56335; font-size: 13px; margin: 0; width: 62px; height: 38px; line-height: 38px; border-radius: 7px; }
.scope { flex-direction: row; justify-content: space-between; margin-top: 24px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: #ecebe7; }
.scope-label { color: #e56335; font-size: 14px; font-weight: bold; }
.scope-description { color: #989a9e; font-size: 11px; }
.customer-row { flex-direction: row; padding-top: 22px; padding-bottom: 22px; border-bottom-width: 1px; border-bottom-color: #ecebe7; }
.avatar { background-color: #f2eae0; width: 46px; height: 46px; border-radius: 12px; align-items: center; justify-content: center; margin-right: 13px; }
.avatar-text { color: #8b7661; font-size: 17px; }
.customer-copy { flex: 1; }
.row { flex-direction: row; justify-content: space-between; align-items: center; }
.customer-name { flex: 1; font-size: 16px; font-weight: bold; color: #21252b; line-height: 23px; }
.chevron { color: #a0a1a4; font-size: 24px; margin-left: 10px; }
.meta { font-size: 12px; color: #85868b; line-height: 20px; margin-top: 6px; }
.address { font-size: 12px; color: #85868b; line-height: 19px; margin-top: 4px; }
.empty { align-items: center; padding-top: 50px; padding-bottom: 38px; }
.empty-icon { color: #cebea8; font-size: 42px; margin-bottom: 16px; }
.empty-title { font-size: 18px; color: #34373d; font-weight: bold; margin-bottom: 10px; }
.empty-copy { font-size: 13px; line-height: 22px; text-align: center; color: #85868b; }
.primary { background-color: #e56335; color: #ffffff; border-radius: 9px; font-size: 15px; margin-top: 25px; width: 100%; }
.secondary { background-color: #fffdf9; color: #e56335; border-radius: 9px; font-size: 13px; margin-top: 14px; }
.notice { margin-top: 20px; background-color: #fff0e8; border-radius: 10px; padding: 16px; }
.notice-title { color: #9b461f; font-size: 14px; font-weight: bold; }
.notice-copy { color: #9b725d; font-size: 12px; line-height: 20px; margin-top: 7px; }
.load-more { margin-top: 18px; color: #e56335; background-color: #f7f1e9; font-size: 13px; border-radius: 9px; }
.draft-section { margin-top: 32px; }
.section-title { font-size: 17px; font-weight: bold; color: #21252b; margin-bottom: 14px; }
.draft-row { flex-direction: row; background-color: #f5f1e9; padding: 16px; margin-bottom: 10px; border-radius: 10px; align-items: center; }
.draft-copy { flex: 1; }
.draft-name { color: #34373d; font-size: 14px; font-weight: bold; }
.orange { color: #e56335; font-size: 13px; margin-left: 10px; }
</style>
