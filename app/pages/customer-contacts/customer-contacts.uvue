<template><scroll-view class="sw-page" direction="vertical" @scrolltolower="more"><view class="c-content"><view class="c-header"><text class="c-heading">{{ newly ? '新增联系人' : '联系人' }}</text><text class="c-muted">{{ total }}人</text></view><text v-if="newly" class="c-muted">{{ from }} — {{ to }}</text><view class="c-search"><image class="c-icon" src="/static/customers/search.svg" /><input class="c-input" v-model="keyword" placeholder="搜索姓名或电话" confirm-type="search" @confirm="search" /><button class="c-search-button" @click="search">搜索</button></view><view v-for="person in people" :key="person.id" class="c-list-row"><view @click="open(person)"><view class="sw-row"><text class="c-name">{{ person.name }} · {{ person.role }}</text><image class="c-arrow" src="/static/home/chevron-right.svg" /></view><text class="c-address">{{ person.stores.length > 1 ? person.storeName + ' 等' + person.stores.length.toString() + '家门店' : person.storeName }}</text></view><view v-if="selectedPerson == person.id"><view v-for="store in person.stores" :key="store.id" class="c-contact-choice" @click="openStore(store.id)"><text class="c-text sw-grow">{{ store.name }} · {{ store.role }}</text><image class="c-arrow" src="/static/home/chevron-right.svg" /></view></view></view><view v-if="error.length > 0" class="c-error"><text class="c-error-text">{{ error }}</text><button class="sw-text-button" @click="search">重试</button></view><view v-if="!loading && error.length == 0 && people.length == 0" class="c-empty"><text class="c-muted">暂无符合条件的联系人</text></view><button v-if="cursor.length > 0" class="sw-text-button" :disabled="loading" @click="more">加载更多</button><text v-if="loading" class="c-muted c-section">加载中…</text></view></scroll-view></template>
<script setup lang="uts">
import { crmToday, crmMessage, crmOwner } from '../../services/crm.uts'
import { customerPeople, CustomerPerson } from '../../services/customer-workbench.uts'
const selectedPerson = ref(''); const newly = ref(false); const from = ref(crmToday()); const to = ref(crmToday()); const keyword = ref(''); const total = ref('—'); const people = ref<CustomerPerson[]>([]); const cursor = ref(''); const error = ref(''); const loading = ref(false)
let generation = 0
async function load(append: boolean): Promise<void> { const request = ++generation; error.value = ''; loading.value = true; if (!append) { people.value = []; selectedPerson.value = ''; total.value = '—'; cursor.value = '' }; try { const response = await customerPeople(newly.value, from.value, to.value, keyword.value.trim(), append ? cursor.value : ''); if (request != generation) return; people.value = append ? people.value.concat(response.items) : response.items; total.value = response.total.toString(); cursor.value = response.cursor } catch (e) { if (request == generation) error.value = crmMessage(e) } finally { if (request == generation) loading.value = false } }
function search(): void { load(false) }
function more(): void { if (!loading.value && cursor.value.length > 0) load(true) }
function openStore(id: string): void { uni.navigateTo({ url: '/pages/customer-detail/customer-detail?id=' + id + '&source=MINE' }) }
function open(person: CustomerPerson): void { if (person.stores.length > 1) selectedPerson.value = selectedPerson.value == person.id ? '' : person.id; else openStore(person.storeId) }
onLoad((options) => { newly.value = options['newly'] == 'true'; from.value = options['from'] ?? crmToday(); to.value = options['to'] ?? crmToday(); search() })
onUnload(() => { generation++ }); watch((): string => crmOwner(), (_value: string) => { generation++; people.value = []; selectedPerson.value = ''; total.value = '—'; cursor.value = ''; error.value = '账号已变更，请重新进入' })
</script>
<style>
@import '../../styles/customers.css';
.c-contact-choice { flex-direction: row; align-items: center; min-height: 48px; margin-top: 6px; padding: 8px; border-radius: 8px; background-color: #f5f6f7; }
</style>
