<template>
  <view class="sw-page">
  <view v-if="launching" class="login-launch">
    <image class="login-launch-logo" src="/static/sales/logo.png" mode="aspectFit" />
    <text v-if="message.length > 0" class="sw-error login-error">{{ message }}</text>
    <button v-if="message.length > 0" class="sw-button sw-primary login-submit" @click="home">重试</button>
  </view>
  <scroll-view v-else class="sw-page" direction="vertical">
    <view class="sw-content login-content">
      <view class="login-brand">
        <image class="login-logo" src="/static/sales/logo.png" mode="aspectFit" />
        <text class="login-brand-name">销售工作台</text>
      </view>
      <view class="login-form">
        <view :class="usernameError.length > 0 ? 'login-field-row login-field-error-row' : 'login-field-row'">
          <text class="login-label">账号</text>
          <input v-model="username" class="login-input" placeholder="请输入账号" :disabled="busy || session.restoring" :maxlength="64" @input="clearUsernameError" />
        </view>
        <text v-if="usernameError.length > 0" class="sw-error login-field-error">{{ usernameError }}</text>
        <view :class="passwordError.length > 0 ? 'login-field-row login-field-error-row' : 'login-field-row'">
          <text class="login-label">密码</text>
          <input v-model="password" class="login-input" :password="!passwordVisible" placeholder="请输入密码" :disabled="busy || session.restoring" :maxlength="1024" confirm-type="done" @confirm="signIn" @input="clearPasswordError" />
          <view class="login-password-control">
            <image class="login-password-icon" :src="passwordVisible ? '/static/login/eye.svg' : '/static/login/eye-closed.svg'" mode="aspectFit" />
            <button class="login-password-toggle" hover-class="login-icon-pressed" :disabled="busy || session.restoring" @click="togglePassword">{{ passwordVisible ? '隐藏密码' : '显示密码' }}</button>
          </view>
        </view>
        <text v-if="passwordError.length > 0" class="sw-error login-field-error">{{ passwordError }}</text>
      </view>
      <checkbox-group class="login-remember" @change="changeRememberLogin">
        <label class="login-remember-label">
          <checkbox value="remember" :checked="rememberLogin" :disabled="busy || session.restoring" color="#c64c1c" />
          <text class="login-remember-text">保持登录</text>
        </label>
      </checkbox-group>
      <view v-if="errorText.length > 0" class="sw-error-panel login-error">
        <text class="sw-error">{{ errorText }}</text>
      </view>
      <button v-if="logoutPending" class="sw-button sw-primary login-submit" hover-class="sw-pressed" :loading="session.logoutState == 'clearing'" :disabled="session.logoutState == 'clearing'" @click="retryLogout">重试退出</button>
      <button v-else :class="busy || session.restoring ? 'sw-button sw-disabled login-submit' : 'sw-button sw-primary login-submit'" hover-class="sw-pressed" :loading="busy || session.restoring" :disabled="busy || session.restoring" @click="signIn">登录</button>
    </view>
  </scroll-view>
  </view>
</template>
<script setup lang="uts">
import { beginCompanyLogin, cancelCompanyLogin, logoutCompany } from '../../services/auth.uts'
import { session } from '../../services/session.uts'
import { readLoginPreference, saveLoginPreference } from '../../services/login-preferences.uts'
const preference = readLoginPreference()
const busy = ref(false)
const message = ref('')
const username = ref(preference.username)
const rememberLogin = ref(preference.rememberLogin)
const password = ref('')
const usernameError = ref('')
const passwordError = ref('')
const passwordVisible = ref(false)
let pageReady = false
let navigating = false
const launching = computed((): boolean => session.restoring || session.authenticated)
const logoutPending = computed((): boolean => session.logoutState == 'clearing' || session.logoutState == 'failed')
const errorText = computed((): string => session.logoutError.length > 0 ? session.logoutError : (message.value.length > 0 ? message.value : session.loginError))
function home(): void {
  if (!pageReady || navigating || session.restoring || !session.authenticated) return
  navigating = true; message.value = ''
  uni.switchTab({ url: '/pages/home/home', fail: (_error) => { navigating = false; message.value = '无法打开首页，请重试' } })
}
function updateEntry(): void {
  if (!pageReady) return
  uni.setNavigationBarTitle({ title: launching.value ? '' : '登录' })
  home()
}
function retryLogout(): void { if (session.logoutState == 'failed') logoutCompany() }
function togglePassword(): void { passwordVisible.value = !passwordVisible.value }
function clearUsernameError(): void { usernameError.value = '' }
function clearPasswordError(): void { passwordError.value = '' }
function changeRememberLogin(event: UniCheckboxGroupChangeEvent): void { rememberLogin.value = event.detail.value.includes('remember') }
function signIn(): void {
  if (busy.value || session.restoring || logoutPending.value) return
  usernameError.value = username.value.trim().length == 0 ? '请输入账号' : ''
  passwordError.value = password.value.length == 0 ? '请输入密码' : ''
  if (usernameError.value.length > 0 || passwordError.value.length > 0) return
  try { saveLoginPreference(username.value, rememberLogin.value) }
  catch (_) { message.value = '无法保存登录设置，请重试。'; return }
  busy.value = true; message.value = ''
  const submittedPassword = password.value
  password.value = ''
  beginCompanyLogin(username.value, submittedPassword, () => { busy.value = false; home() }, (error) => { busy.value = false; message.value = error }, rememberLogin.value)
}
onReady(() => { pageReady = true; updateEntry() })
onShow(() => { updateEntry() })
watch((): boolean => session.restoring, (_restoring: boolean) => { updateEntry() })
watch((): boolean => session.authenticated, (_authenticated: boolean) => { updateEntry() })
onUnload(() => { password.value = ''; cancelCompanyLogin() })
</script>
<style>
@import "../../styles/workbench-ui.css";
.login-launch { flex: 1; align-items: center; justify-content: center; padding: 24px; }
.login-launch-logo { width: 72px; height: 72px; }
.login-content { max-width: 480px; padding-top: 40px; }
.login-brand { flex-direction: row; align-items: center; margin-bottom: 48px; }
.login-logo { width: 44px; height: 44px; margin-right: 10px; }
.login-brand-name { color: var(--sw-ink); font-size: 20px; line-height: 30px; font-weight: bold; }
.login-field-row { flex-direction: row; align-items: center; min-height: 68px; border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: var(--sw-border); }
.login-field-error-row { border-bottom-color: var(--sw-error); }
.login-label { width: 56px; color: var(--sw-ink); font-size: 16px; line-height: 24px; }
.login-input { flex: 1; min-width: 0; height: 54px; padding: 0 8px; font-size: 16px; color: var(--sw-ink); }
.login-password-control { position: relative; width: 48px; height: 48px; }
.login-password-icon { position: absolute; left: 13px; top: 13px; width: 22px; height: 22px; }
.login-password-toggle { margin: 0; width: 48px; height: 48px; padding: 0; border-width: 0; border-radius: 8px; background-color: transparent; color: transparent; font-size: 10px; line-height: 48px; }
.login-icon-pressed { background-color: rgba(98, 105, 112, 0.08); }
.login-remember { margin-top: 8px; align-self: flex-start; }
.login-remember-label { flex-direction: row; align-items: center; min-height: 48px; }
.login-remember-text { margin-left: 6px; color: var(--sw-muted); font-size: 14px; line-height: 22px; }
.login-field-error { margin-top: 8px; margin-left: 64px; }
.login-error { margin-top: 20px; }
.login-submit { margin-top: 16px; }

/* #ifdef APP-ANDROID */
.login-brand-name { font-family: sans-serif; }
/* #endif */
</style>
