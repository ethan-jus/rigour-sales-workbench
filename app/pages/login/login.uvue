<template>
  <scroll-view class="page" direction="vertical"><view class="content login-content">
    <image class="login-logo" src="/static/sales/logo.png" mode="aspectFit"/>
    <text class="eyebrow">RIGOUR WORKSPACE</text><text class="login-heading">欢迎回到
销售工作台</text>
    <text class="login-copy">让每一次拜访，都有新的进展。</text>
    <text v-if="development" class="fine login-note">开发环境 · 与正式业务数据隔离</text>
    <view class="sign-in-panel"><text class="h2">使用公司账号登录</text><text class="body panel-copy">与供应链系统使用同一个账号，功能和数据权限由公司统一管理。</text>
      <text class="field-label">公司账号</text>
      <input v-model="username" class="login-input" placeholder="请输入供应链系统账号" :disabled="busy || session.restoring" :maxlength="64"/>
      <text class="field-label">密码</text>
      <view class="password-row"><input v-model="password" class="password-input" :password="!passwordVisible" placeholder="请输入密码" :disabled="busy || session.restoring" :maxlength="1024" confirm-type="done" @confirm="signIn"/><text class="password-toggle" @click="togglePassword">{{ passwordVisible ? '隐藏' : '显示' }}</text></view>
      <button class="primary" :disabled="busy || session.restoring" @click="signIn">{{ session.restoring ? '正在恢复登录…' : (busy ? '登录中…' : '登录工作台') }}</button>
      <view v-if="message.length > 0 || session.loginError.length > 0" class="error"><text class="error-text">{{ message.length > 0 ? message : session.loginError }}</text></view>
      <text class="fine login-note">账号由公司统一管理；App 不保存密码。</text>
    </view>
    <button class="secondary" @click="home">先看看工作台</button>
    <view class="login-footer"><text class="fine">瑞盖销售工作台 · 内部试用版</text></view>
  </view></scroll-view>
</template>
<script setup lang="uts">
import { beginCompanyLogin, cancelCompanyLogin } from '../../services/auth.uts'
import { session } from '../../services/session.uts'
import { appEnvironment } from '../../services/config.uts'
const development = appEnvironment.environment == 'development'
const busy = ref(false)
const message = ref('')
const username = ref('')
const password = ref('')
const passwordVisible = ref(false)
function home(): void { uni.switchTab({ url: '/pages/home/home' }) }
function togglePassword(): void { passwordVisible.value = !passwordVisible.value }
function signIn(): void {
  if (busy.value || session.restoring) return
  if (username.value.trim().length == 0 || password.value.length == 0) { message.value = '请输入公司账号和密码。'; return }
  busy.value = true; message.value = ''
  const submittedPassword = password.value
  password.value = ''
  beginCompanyLogin(username.value, submittedPassword, () => { busy.value = false; home() }, (error) => { busy.value = false; message.value = error })
}
onShow(() => { if (session.authenticated) { busy.value = false; home() } })
watch((): boolean => session.restoring, (restoring: boolean) => { if (!restoring && session.authenticated && !busy.value) home() })
onUnload(() => { password.value = ''; cancelCompanyLogin() })
</script>
<style>
.login-content { padding-top: 38px; }
.login-logo { width: 54px; height: 54px; margin-bottom: 25px; }
.eyebrow { color: #b24f2d; font-size: 11px; letter-spacing: 2px; margin-bottom: 14px; }
.login-heading { color: #21252b; font-size: 34px; line-height: 47px; font-weight: bold; }
.login-copy { color: #777d84; font-size: 14px; line-height: 23px; margin-top: 15px; }
.sign-in-panel { background-color: #f8f7f4; padding: 22px; border-radius: 8px; margin-top: 42px; }
.panel-copy { margin-top: 12px; margin-bottom: 8px; }
.field-label { color: #434950; font-size: 13px; margin-top: 16px; margin-bottom: 8px; }
.login-input { background-color: #ffffff; border: 1px solid #e4e2dc; border-radius: 6px; padding: 0 12px; height: 48px; font-size: 15px; color: #21252b; }
.password-row { flex-direction: row; align-items: center; background-color: #ffffff; border: 1px solid #e4e2dc; border-radius: 6px; height: 48px; }
.password-input { flex: 1; height: 46px; padding: 0 12px; font-size: 15px; color: #21252b; }
.password-toggle { color: #a44726; font-size: 13px; padding: 14px 12px; }
.login-note { margin-top: 17px; }
.login-footer { align-items: center; margin-top: 42px; }
</style>
