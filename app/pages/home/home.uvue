.home-attendance-face { width: 32px; height: 32px; margin-right: 5px; }
.home-attendance-label { color: #626970; font-size: 14px; line-height: 22px; }
.home-attendance-working { color: #c64c1c; }
.home-attendance-finished { color: #2f7351; }
.home-page { padding-top: var(--uni-safe-area-inset-top); }
.home-content { max-width: 480px; padding: 20px; padding-bottom: 36px; }
.home-header { margin-bottom: 20px; min-height: 44px; }
.home-logo { width: 28px; height: 32px; margin-right: 10px; }
.home-title { font-size: 23px; line-height: 32px; font-weight: bold; color: var(--sw-ink); }
.home-checked { font-size: 14px; color: var(--sw-muted); padding: 10px 14px; }
.home-period-row { margin-bottom: 16px; }
.home-period-tabs { flex-direction: row; padding: 3px; border-radius: 14px; background-color: var(--sw-surface); }
.home-period { padding: 8px 12px; min-height: 40px; margin: 0; border-width: 0; border-radius: 11px; background-color: transparent; color: var(--sw-muted); font-size: 14px; line-height: 24px; }
.home-period-active { background-color: var(--sw-accent-soft); color: var(--sw-accent); font-weight: bold; }
.home-date-select { flex-direction: row; align-items: center; min-height: 44px; }
.home-date-chevron { width: 14px; height: 14px; margin-left: 4px; }
.home-date-menu { flex-direction: row; background-color: var(--sw-surface); border-radius: 12px; padding: 6px; margin-bottom: 16px; }
.home-date-option { flex: 1; margin: 0; border-width: 0; background-color: transparent; font-size: 14px; line-height: 24px; padding: 10px; color: var(--sw-ink); }
.home-month-picker { flex: 1; }
.home-date-option-view { padding: 10px; align-items: center; }
.home-date-option-text { font-size: 14px; line-height: 24px; color: var(--sw-ink); }
.home-date-range { color: var(--sw-muted); font-size: 12px; margin-left: 8px; }
.home-snapshot-hint { color: var(--sw-muted); font-size: 12px; line-height: 20px; margin-bottom: 8px; }
.home-finance { background-color: var(--sw-surface); border-radius: 18px; padding: 16px 16px 0; }
.home-finance-main { flex-direction: row; padding-bottom: 12px; }
.home-finance-cell { flex: 1; min-width: 0; }
.home-finance-second { padding-left: 16px; border-left-width: 1px; border-left-style: solid; border-left-color: var(--sw-border); }
.home-finance-label { color: var(--sw-muted); font-size: 13px; line-height: 22px; }
.home-money-row { flex-direction: row; align-items: center; margin-top: 4px; min-height: 32px; }
.home-currency { color: var(--sw-ink); font-size: 14px; line-height: 32px; font-weight: bold; margin-right: 1px; }
.home-money { color: var(--sw-ink); font-size: 24px; line-height: 32px; font-weight: bold; flex-shrink: 1; }
.home-order-count { color: var(--sw-muted); font-size: 12px; line-height: 24px; margin-left: 6px; flex-shrink: 0; }
.home-metric-chevron { width: 12px; height: 16px; flex-shrink: 0; opacity: 0.65; }
.home-orange { color: var(--sw-accent); }
.home-chevron { width: 17px; height: 20px; margin-left: 7px; flex-shrink: 0; opacity: 0.7; }
.home-performance { padding: 12px 0 16px; border-top-width: 1px; border-top-style: solid; border-top-color: var(--sw-border); }
.home-performance-title { color: var(--sw-ink); font-size: 14px; font-weight: bold; line-height: 22px; }
.home-progress-percent { color: var(--sw-accent); font-size: 15px; font-weight: bold; line-height: 22px; }
.home-progress-track { height: 6px; border-radius: 3px; background-color: var(--sw-border); margin-top: 8px; overflow: hidden; }
.home-progress-fill { height: 6px; border-radius: 3px; background-color: var(--sw-accent); }
.home-performance-amounts { flex-direction: row; margin-top: 8px; }
.home-performance-cell { flex: 1; min-width: 0; flex-direction: row; align-items: center; }
.home-target { justify-content: flex-end; padding-left: 8px; }
.home-performance-label { color: var(--sw-muted); font-size: 12px; line-height: 22px; margin-right: 6px; }
.home-performance-value { color: var(--sw-ink); font-size: 14px; font-weight: bold; line-height: 22px; }
.home-visits { margin-top: 24px; }
.home-section-title { color: var(--sw-ink); font-size: 18px; font-weight: bold; line-height: 28px; margin-bottom: 4px; }
.home-visits-title { margin-bottom: 8px; }
.home-visit-row { flex-direction: row; }
