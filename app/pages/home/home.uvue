<template>
  <scroll-view class="page" direction="vertical">
    <view class="content">
      <view class="row-between brand-row">
        <view class="row"><image class="brand-logo" src="/static/sales/logo.png" mode="aspectFit"/><text class="brand-name">瑞盖 · 销售工作台</text></view>
        <text class="avatar" @click="profile">{{ initial }}</text>
      </view>
      <text class="fine">{{ today }}</text>
      <view class="row-between title-row"><text class="h1">我的业务</text><text class="period">本月</text></view>
      <view class="metrics">
        <view class="metric" @click="openWork('performance')"><text class="muted">本月订单金额</text><text class="amount">—</text><text class="fine">{{ session.authenticated ? '统计服务待接入' : '登录后查看业务' }}</text></view>
        <view class="metric" @click="openWork('cashflow')"><text class="muted">本月已确认到账</text><text class="amount">—</text><text class="fine">以财务确认结果为准</text></view>
      </view>
      <view class="actions">
        <view class="action" @click="startVisit"><image class="action-icon" src="/static/tabs/visit-active.png"/><text class="action-label">{{ recording ? '继续拜访' : '开始拜访' }}</text><text class="arrow">›</text></view>
        <view class="action action-last" @click="products"><image class="action-icon" src="/static/tabs/product-active.png"/><text class="action-label">查商品</text><text class="arrow">›</text></view>
      </view>
      <view v-if="!session.authenticated" class="login-card">
        <text class="badge">公司统一账号</text><text class="login-title">把今天的工作，放在一起</text><text class="body">客户、订单与拜访，使用供应链系统账号登录。</text>
        <button class="primary" @click="login">登录工作台</button>
      </view>
      <view v-if="session.authenticated && draftCount > 0" class="login-card">
        <text class="badge">未完成订单</text><text class="login-title">{{ draftName }}</text><text class="body">{{ draftCount }} 份本机购物草稿，尚未提交</text><button class="primary" @click="openDraft">继续完善订单</button>
      </view>
      <view class="section">
        <view class="row-between"><text class="h2">需要你跟进</text><text class="link" @click="openWork('messages')">查看全部 ›</text></view>
        <view class="task-row" @click="uploads"><image class="task-icon" src="/static/tabs/upload.png"/><view class="grow"><text class="h3">拜访草稿</text><text class="muted">{{ visitCount > 0 ? visitCount.toString() + ' 份保存在本机，尚未提交' : '继续完善现场记录与附件' }}</text></view><text class="arrow">›</text></view>
        <view class="task-row" @click="openPlan"><image class="task-icon" src="/static/tabs/calendar.png"/><view class="grow"><text class="h3">拜访计划</text><text class="muted">查看公司分配的拜访安排</text></view><text class="arrow">›</text></view>
      </view>
      <view class="summary" @click="visits"><text class="muted">本月拜访</text><text class="summary-count">{{ visitsTotal }}</text><text class="fine">{{ summaryHint }}</text></view>
      <view class="task-row" @click="openWork('performance')"><image class="task-icon" src="/static/tabs/chart.png"/><view class="grow"><text class="h3">我的业绩与提成</text><text class="muted">查看工作成果与结算进度</text></view><text class="arrow">›</text></view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
import { session, hasPermission } from '../../services/session.uts'
import { requestApi } from '../../services/api.uts'
import { commerce, loadDrafts, preloadCommerceLists, CartDraft } from '../../services/commerce.uts'
import { loadLocalVisits, visitDraftCount, hasActiveVisitRecording, resumeVisitPath, visitToday } from '../../services/visits.uts'
const today = ref(visitToday())
const visitsTotal = ref('—')
const summaryHint = ref('登录后查看本人拜访记录')
const initial = computed((): string => session.displayName.length > 0 ? session.displayName.substring(0, 1) : '我')
const drafts = computed((): CartDraft[] => session.authenticated ? commerce.drafts.filter((draft: CartDraft): boolean => draft.lines.length > 0) : [] as CartDraft[])
const draftCount = computed((): number => drafts.value.length)
const draftName = computed((): string => drafts.value.length > 0 ? drafts.value[0].customerName : '')
const visitCount = computed((): number => visitDraftCount())
const recording = computed((): boolean => hasActiveVisitRecording())
let visible = false
function login(): void { uni.navigateTo({ url: '/pages/login/login' }) }
function profile(): void { uni.switchTab({ url: '/pages/profile/profile' }) }
function openDraft(): void {
  if (drafts.value.length == 0) return
  commerce.selectedCustomerId = drafts.value[0].customerId
  uni.navigateTo({ url: '/pages/commerce/commerce?view=cart' })
}
function visits(): void { uni.switchTab({ url: '/pages/visits/visits' }) }
function products(): void { uni.navigateTo({ url: '/pages/commerce/commerce?view=products' }) }
function uploads(): void { uni.navigateTo({ url: '/pages/visit/visit?view=uploads' }) }
function openPlan(): void { uni.navigateTo({ url: '/pages/visit/visit?view=plan' }) }
function openWork(view: string): void { uni.navigateTo({ url: '/pages/work/work?view=' + view }) }
function startVisit(): void { uni.navigateTo({ url: recording.value ? resumeVisitPath() : '/pages/visit/visit?view=select' }) }
function loadHome(): void {
  loadDrafts(); preloadCommerceLists(); loadLocalVisits(); visitsTotal.value = '—'; today.value = visitToday()
  summaryHint.value = session.authenticated ? '当前账号暂无拜访统计权限' : '登录后查看本人拜访记录'
  if (!hasPermission('sales:visit:own:read')) return
  summaryHint.value = '正在加载…'
  requestApi('/sales/me/activity-summary?from=' + today.value.substring(0, 7) + '-01&to=' + today.value, 'GET', null, (response) => {
    const data = response.getJSON('data')
    const count = data?.getNumber('totalVisitCount')
    visitsTotal.value = count == null ? '—' : count.toString()
    summaryHint.value = count == null ? '统计暂不可用' : '按北京时间统计 · 点击查看明细'
  }, (message) => { summaryHint.value = message })
}
onShow(() => { visible = true; loadHome() })
onHide(() => { visible = false })
watch((): boolean => session.authenticated, (_: boolean) => { if (visible) loadHome() })
</script>
<style>
.brand-row { margin-bottom: 28px; }
.brand-logo { width: 30px; height: 30px; margin-right: 9px; }
.brand-name { font-size: 15px; color: #21252b; font-weight: bold; }
.avatar { width: 34px; height: 34px; border-radius: 17px; background-color: #f0eee9; color: #71675f; text-align: center; line-height: 34px; font-size: 14px; }
.title-row { margin-top: 6px; }
.period { font-size: 12px; color: #72777c; padding: 7px 12px; background-color: #f6f5f2; border-radius: 4px; }
.metrics { flex-direction: row; padding-top: 23px; padding-bottom: 26px; }
.metric { flex: 1; }
.amount { color: #21252b; font-size: 29px; font-weight: bold; line-height: 46px; }
.actions { flex-direction: row; margin-bottom: 23px; }
.action { flex: 1; background-color: #fff1e8; border-radius: 6px; padding: 17px 12px; flex-direction: row; align-items: center; }
.action-last { margin-left: 12px; background-color: #f5f4f0; }
.action-icon { width: 24px; height: 24px; margin-right: 9px; }
.action-label { font-size: 15px; color: #373330; font-weight: bold; flex: 1; }
.arrow { color: #a5a6a5; font-size: 23px; margin-left: 6px; }
.login-card { border-radius: 8px; padding: 20px; background-color: #f8f7f4; align-items: stretch; }
.login-title { color: #21252b; font-weight: bold; font-size: 20px; line-height: 30px; margin-top: 16px; margin-bottom: 9px; }
.task-row { flex-direction: row; align-items: center; padding: 20px 0; border-bottom-width: 1px; border-bottom-color: #ededea; }
.task-icon { width: 24px; height: 24px; margin-right: 13px; }
.summary { background-color: #f8f7f4; padding: 18px; border-radius: 6px; margin-top: 20px; }
.summary-count { font-size: 25px; line-height: 40px; color: #21252b; font-weight: bold; }
</style>
