.home-visit-cell { flex: 1; min-width: 0; flex-direction: row; align-items: center; min-height: 48px; padding-right: 16px; }
.home-visit-second { padding-left: 18px; padding-right: 0; border-left-width: 1px; border-left-style: solid; border-left-color: var(--sw-border); }
.home-visit-label { color: var(--sw-muted); font-size: 14px; line-height: 24px; margin-right: 10px; }
.home-visit-value { color: var(--sw-ink); font-size: 20px; font-weight: bold; line-height: 28px; }
.home-actions { flex-direction: row; align-items: center; margin-top: 20px; margin-bottom: 24px; }
.home-start-control { position: relative; width: 124px; flex-shrink: 0; border-radius: 12px; background-color: var(--sw-accent); }
.home-start-icon { position: absolute; left: 12px; top: 13px; width: 26px; height: 26px; }
.home-start { width: 100%; padding: 14px 8px 14px 40px; margin: 0; min-height: 52px; border-width: 0; border-radius: 12px; background-color: transparent; color: var(--sw-canvas); font-size: 16px; line-height: 24px; }
.home-start-pressed { background-color: rgba(255, 255, 255, 0.16); }
.home-control-pressed { background-color: rgba(98, 105, 112, 0.08); }
.home-tool { flex: 1; position: relative; align-items: center; min-width: 0; margin-left: 8px; }
.home-tool-icon { position: absolute; width: 28px; height: 28px; top: 0; }
.home-tool-button { width: 100%; padding: 32px 0 0; margin: 0; min-height: 52px; border-width: 0; border-radius: 8px; background-color: transparent; color: var(--sw-ink); font-size: 14px; line-height: 20px; }
.home-task { flex-direction: row; align-items: center; min-height: 52px; padding: 0; }
.home-task-border { border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: var(--sw-border); }
.home-task-icon { width: 26px; height: 26px; margin-right: 16px; }
.home-task-label { color: var(--sw-ink); font-size: 16px; font-weight: bold; line-height: 24px; }
.home-task-count { color: var(--sw-muted); font-size: 20px; font-weight: bold; }
.home-task-count.home-orange { color: var(--sw-accent); }
.home-error { margin-top: 20px; }

/* #ifdef APP-ANDROID */
.home-title,
.home-period-active,
.home-currency,
.home-money,
.home-performance-title,
.home-progress-percent,
.home-performance-value,
.home-section-title,
