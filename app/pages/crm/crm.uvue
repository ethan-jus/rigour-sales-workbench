<template>
  <scroll-view class="page" direction="vertical" :scroll-into-view="scrollTarget">
    <view class="content">
      <view v-if="error.length > 0" id="crm-error" class="notice"><text class="notice-text">{{ error }}</text><button class="secondary" :disabled="loading || busy" @click="showPage">重新加载</button></view>
      <text v-if="loading" class="body section">正在加载…</text>
      <view v-if="mode.length > 0" id="contact-editor" class="editor panel">
        <text class="title">{{ editorTitle }}</text>
        <template v-if="mode == 'profile'"><text class="label">门店名称</text><input class="field" v-model="profileName" maxlength="200" /><text class="label">地址</text><input class="field" v-model="profileAddress" maxlength="500" /><text class="label">公开电话</text><input class="field" v-model="profilePhone" maxlength="50" /></template>
        <template v-if="mode == 'business'"><text class="body">记录本次核实的经营情况。暂停营业会暂停新拜访；确认停业会结束本人归属，保留客户历史。</text><button v-for="code in businessOptions" :key="code" :class="businessStatus == code ? 'primary' : 'secondary'" @click="businessStatus = code">{{ businessLabel(code) }}</button></template>
        <template v-if="mode == 'link'"><text class="label">来源门店</text><view class="search-row"><input class="field grow" v-model="sourceKeyword" placeholder="搜索本人其他门店" /><button class="small-button" @click="searchSource">查询</button></view><button v-for="item in sourceStores" :key="item.id" class="secondary" @click="chooseSource(item.id)">{{ sourceId == item.id ? '已选 · ' : '' }}{{ item.name }}</button><button v-for="person in sourcePeople" :key="person.id" class="secondary" @click="sourceContact = person.id">{{ sourceContact == person.id ? '已选 · ' : '' }}{{ person.name }} · {{ person.role }}</button></template>
        <template v-if="mode == 'create' || mode == 'edit'"><text class="label">姓名或称呼 *</text><input class="field" v-model="name" maxlength="100" /></template>
        <template v-if="mode == 'create' || mode == 'edit' || mode == 'link'"><text class="label">本店角色 *</text><input class="field" v-model="role" placeholder="老板、店长、前台等" maxlength="50" /><view class="switch-row"><text class="body">本店主要联系人</text><switch :checked="primary" @change="changePrimary" /></view></template>
        <template v-if="mode == 'create'"><text class="label">手机或座机电话（选填）</text><input class="field" v-model="phone" type="text" placeholder="座机请带区号" /><text class="label">微信线索（选填）</text><input class="field" v-model="wechat" placeholder="手填昵称不算已建联" /><text class="body">新录电话保存为待核实。</text></template>
        <template v-if="mode == 'edit'"><view class="switch-row"><text class="body">已离职 / 本店关系失效</text><switch :checked="status == 'LEFT'" @change="changeStatus" /></view><text class="body">姓名与联系方式由关联门店共用，角色及离职状态仅影响本店。</text></template>
        <template v-if="mode == 'method'"><view class="tabs"><button :class="methodType == 'PHONE' ? 'tab active' : 'tab'" @click="methodType = 'PHONE'">电话</button><button :class="methodType == 'WECHAT_HINT' ? 'tab active' : 'tab'" @click="methodType = 'WECHAT_HINT'">微信线索</button></view><text class="label">联系方式 *</text><input class="field" v-model="methodValue" /></template>
        <template v-if="mode == 'verify'"><text class="body">{{ currentMethod?.value }}</text><view class="tabs"><button :class="methodStatus == 'VERIFIED' ? 'tab active' : 'tab'" @click="methodStatus = 'VERIFIED'">已确认</button><button :class="methodStatus == 'INVALID' ? 'tab active' : 'tab'" @click="methodStatus = 'INVALID'">失效</button><button :class="methodStatus == 'PENDING' ? 'tab active' : 'tab'" @click="methodStatus = 'PENDING'">待核实</button></view><view v-if="methodStatus == 'VERIFIED'" class="tabs"><button :class="verification == 'PHONE_CALL' ? 'tab active' : 'tab'" @click="verification = 'PHONE_CALL'">已拨通</button><button :class="verification == 'ON_SITE' ? 'tab active' : 'tab'" @click="verification = 'ON_SITE'">现场确认</button></view></template>
        <template v-if="mode != 'create' && mode != 'history'"><text class="label">核验依据或变更原因 *</text><textarea class="textarea" v-model="reason" maxlength="500" /></template>
        <template v-if="mode == 'history'"><text v-for="(item, index) in history" :key="index" class="body">{{ item }}</text></template>
        <button v-else class="primary" :disabled="busy" @click="save">{{ busy ? '保存中…' : '保存' }}</button><button class="secondary" :disabled="busy" @click="closeEditor">关闭</button>
      </view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
import { session } from '../../services/session.uts'
import { crmList, crmDetail, crmContacts, crmMutation, crmCall, crmTime, crmMessage, crmOwner, CrmStore, CrmContact, CrmMethod } from '../../services/crm.uts'
const editorOnly = ref(false); const requestedEditor = ref(''); const requestedContact = ref(''); const requestedMethod = ref(''); const profileName = ref(''); const profileAddress = ref(''); const profilePhone = ref('')
const storeId = ref('')
const store = ref<CrmStore | null>(null); const contacts = ref<CrmContact[]>([]); const loading = ref(false); const busy = ref(false); const error = ref('')
const scrollTarget = ref('')
const businessOptions = ['OPEN', 'TEMP_CLOSED', 'CLOSED']; const businessStatus = ref('OPEN')
const mode = ref(''); const current = ref<CrmContact | null>(null); const currentMethod = ref<CrmMethod | null>(null)
const name = ref(''); const role = ref(''); const phone = ref(''); const wechat = ref(''); const primary = ref(false); const status = ref('ACTIVE'); const reason = ref('')
const methodType = ref('PHONE'); const methodValue = ref(''); const methodStatus = ref('VERIFIED'); const verification = ref('PHONE_CALL')
const sourceKeyword = ref(''); const sourceId = ref(''); const sourceContact = ref(''); const sourceStores = ref<CrmStore[]>([]); const sourcePeople = ref<CrmContact[]>([]); const history = ref<string[]>([])
const editorTitle = computed((): string => mode.value == 'profile' ? '编辑客户资料' : mode.value == 'release' ? '释放客户' : mode.value == 'business' ? '维护经营状态' : mode.value == 'create' ? '新增联系人' : mode.value == 'edit' ? '编辑联系人关系' : mode.value == 'method' ? '补充联系方式' : mode.value == 'verify' ? '核验电话' : mode.value == 'link' ? '关联已有联系人' : '变更记录')
function businessLabel(code: string): string { return code == 'OPEN' ? '正常营业' : code == 'TEMP_CLOSED' ? '暂停营业' : code == 'CLOSED' ? '已停业' : '待核实' }
watch(error, (message: string) => { if (message.length > 0) { scrollTarget.value = ''; nextTick(() => { scrollTarget.value = 'crm-error' }) } })
let generation = 0; let owner = ''
function changePrimary(event: UniSwitchChangeEvent): void { primary.value = event.detail.value }
function changeStatus(event: UniSwitchChangeEvent): void { status.value = event.detail.value ? 'LEFT' : 'ACTIVE' }
async function reload(): Promise<void> {
  if (!session.authenticated || !editorOnly.value || storeId.value.length == 0) return
  const version = ++generation; loading.value = true; error.value = ''; store.value = null; contacts.value = []
  try { const detail = await crmDetail(storeId.value); const people = await crmContacts(storeId.value); if (version != generation) return; store.value = detail; contacts.value = people }
  catch (e) { if (version == generation) error.value = crmMessage(e) } finally { if (version == generation) loading.value = false }
}
function edit(next: string, person: CrmContact | null, channel: CrmMethod | null): void {
  scrollTarget.value = ''; nextTick(() => { scrollTarget.value = 'contact-editor' });
  current.value = person; currentMethod.value = channel; mode.value = next; name.value = person?.name ?? ''; role.value = person?.role ?? ''; primary.value = person?.primary ?? false; status.value = person?.status ?? 'ACTIVE'
  phone.value = ''; wechat.value = ''; reason.value = ''; methodValue.value = ''; methodType.value = 'PHONE'; methodStatus.value = 'VERIFIED'; verification.value = 'PHONE_CALL'; sourceId.value = ''; sourceContact.value = ''; sourceStores.value = []; sourcePeople.value = []; history.value = []
}
function editBusiness(): void { edit('business', null, null); businessStatus.value = store.value?.businessStatus == 'TEMP_CLOSED' ? 'TEMP_CLOSED' : 'OPEN' }
async function saveBusiness(): Promise<void> {
  const currentStore = store.value
  if (currentStore == null) return
  if (businessStatus.value == currentStore.businessStatus) { error.value = '经营状态没有变化'; return }
  busy.value = true; error.value = ''
  try {
    if (businessStatus.value == 'CLOSED') {
      const confirmed = await new Promise<boolean>((resolve) => { uni.showModal({ title: '确认门店已停业', content: '将结束本人负责关系并暂停新作业，客户、联系人和拜访历史仍保留。', confirmText: '确认停业', success: (result) => resolve(result.confirm), fail: (_) => resolve(false) }) })
      if (!confirmed) return
    }
    await crmMutation('/crm/stores/' + currentStore.id + '/business-status', 'PUT', { revision: currentStore.revision, status: businessStatus.value, reason: reason.value.trim(), management: false } as UTSJSONObject)
    mode.value = ''; uni.showToast({ title: '经营状态已保存', icon: 'none' })
    if (businessStatus.value != 'CLOSED') await reload()
  } catch (e) { error.value = crmMessage(e) } finally { busy.value = false }
}
function closeEditor(): void { if (editorOnly.value) uni.navigateBack(); else mode.value = '' }
async function saveProfile(): Promise<void> {
  const currentStore = store.value
  if (currentStore == null || busy.value) return
  if (profileName.value.trim().length == 0 || profileAddress.value.trim().length == 0) { error.value = '请填写门店名称和地址'; return }
  busy.value = true; error.value = ''
  try { await crmMutation('/crm/stores/' + currentStore.id, 'PUT', { revision: currentStore.revision, name: profileName.value.trim(), address: profileAddress.value.trim(), publicPhone: profilePhone.value.trim(), storeTypeCode: currentStore.storeType, reason: reason.value.trim() } as UTSJSONObject); uni.showToast({ title: '已保存', icon: 'none' }); uni.navigateBack() }
  catch (e) { error.value = crmMessage(e) } finally { busy.value = false }
}
async function releaseStore(): Promise<void> {
  const currentStore = store.value; if (currentStore == null || busy.value) return
  busy.value = true
  try {
    const confirmed = await new Promise<boolean>((resolve) => { uni.showModal({ title: '释放客户', content: '“' + currentStore.name + '”将回到公海，当前负责关系结束。', confirmText: '确认释放', success: (r) => resolve(r.confirm), fail: (_) => resolve(false) }) })
    if (!confirmed) return
    await crmMutation('/crm/stores/' + currentStore.id + '/release', 'POST', { revision: currentStore.revision, reason: reason.value.trim() } as UTSJSONObject)
    uni.navigateBack(); uni.showToast({ title: '已释放到公海', icon: 'none' })
  } catch (e) { error.value = crmMessage(e) } finally { busy.value = false }
}
async function save(): Promise<void> {
  if (busy.value) return
  if (['create', 'edit', 'link'].includes(mode.value) && (role.value.trim().length == 0 || (mode.value != 'link' && name.value.trim().length == 0))) { error.value = '请填写姓名或称呼与本店角色'; return }
  if (mode.value != 'create' && reason.value.trim().length == 0) { error.value = '请填写依据或原因'; return }
  if (mode.value == 'release') { await releaseStore(); return }
  if (mode.value == 'profile') { await saveProfile(); return }
  if (mode.value == 'business') { await saveBusiness(); if (editorOnly.value && mode.value.length == 0) uni.navigateBack(); return }
  busy.value = true; error.value = ''
  const base = '/crm/stores/' + storeId.value + '/contacts'; const person = current.value
  try {
    if (mode.value == 'create') await crmMutation(base, 'POST', { name: name.value.trim(), role: role.value.trim(), phone: phone.value.trim(), wechatHint: wechat.value.trim(), primary: primary.value } as UTSJSONObject)
    else if (mode.value == 'edit' && person != null) await crmMutation(base + '/' + person.id, 'PUT', { name: name.value.trim(), role: role.value.trim(), primary: status.value == 'ACTIVE' && primary.value, status: status.value, revision: person.revision, personRevision: person.personRevision, reason: reason.value.trim() } as UTSJSONObject)
    else if (mode.value == 'method' && person != null) await crmMutation(base + '/' + person.id + '/methods', 'POST', { type: methodType.value, value: methodValue.value.trim(), reason: reason.value.trim() } as UTSJSONObject)
    else if (mode.value == 'verify' && person != null && currentMethod.value != null) await crmMutation(base + '/' + person.id + '/methods/' + currentMethod.value!.id + '/verification', 'PUT', { revision: currentMethod.value!.revision, status: methodStatus.value, verificationMethod: verification.value, reason: reason.value.trim() } as UTSJSONObject)
    else if (mode.value == 'link') { if (sourceContact.value.length == 0) throw new Error('请选择来源门店及联系人'); await crmMutation(base + '/link', 'POST', { sourceStoreId: sourceId.value, contactId: sourceContact.value, role: role.value.trim(), primary: primary.value, reason: reason.value.trim() } as UTSJSONObject) }
    else throw new Error('联系人状态已变更，请返回刷新')
    mode.value = ''; if (editorOnly.value) uni.navigateBack(); else await reload(); uni.showToast({ title: '联系人已保存', icon: 'none' })
  } catch (e) { error.value = crmMessage(e) } finally { busy.value = false }
}
async function searchSource(): Promise<void> { try { sourceStores.value = (await crmList('MINE', sourceKeyword.value.trim())).items.filter((s: CrmStore): boolean => s.id != storeId.value) } catch (e) { error.value = crmMessage(e) } }
async function chooseSource(id: string): Promise<void> { sourceId.value = id; sourceContact.value = ''; sourcePeople.value = []; try { const people = await crmContacts(id); if (sourceId.value == id) sourcePeople.value = people.filter((p: CrmContact): boolean => p.status == 'ACTIVE') } catch (e) { error.value = crmMessage(e) } }
async function showHistory(person: CrmContact): Promise<void> { edit('history', person, null); try { const response = await crmCall('/crm/stores/' + storeId.value + '/contacts/' + person.id + '/changes'); const rows = (response['data'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]; history.value = rows.map((r: UTSJSONObject): string => crmTime(r.getString('occurredAt') ?? '') + ' · ' + (r.getString('reason') ?? '')) } catch (e) { error.value = crmMessage(e) } }
onLoad((options) => { storeId.value = options['store'] ?? ''; if ((options['editor'] ?? '').length == 0) { uni.redirectTo({ url: storeId.value.length > 0 ? '/pages/customer-detail/customer-detail?id=' + storeId.value + '&source=MINE' : '/pages/customer-list/customer-list?kind=MINE' }); return }; requestedEditor.value = options['editor'] ?? ''; editorOnly.value = requestedEditor.value.length > 0; requestedContact.value = options['contact'] ?? ''; requestedMethod.value = options['method'] ?? ''; if (editorOnly.value) uni.setNavigationBarTitle({ title: requestedEditor.value == 'release' ? '释放客户' : requestedEditor.value == 'profile' ? '编辑客户' : requestedEditor.value == 'business' ? '经营状态' : '联系人' }) })
let pageVisible = false
async function showPage(): Promise<void> { const next = crmOwner(); if (next != owner) { owner = next; generation++; store.value = null; contacts.value = []; mode.value = '' }; await reload(); if (editorOnly.value && store.value != null && error.value.length == 0) { const person = contacts.value.find((p: CrmContact): boolean => p.id == requestedContact.value) ?? null; const channel = person?.methods.find((m: CrmMethod): boolean => m.id == requestedMethod.value) ?? null; if ((['edit', 'method', 'verify', 'history'].includes(requestedEditor.value) && person == null) || (requestedEditor.value == 'verify' && channel == null)) { mode.value = ''; error.value = '联系人或联系方式已变更，请返回刷新'; return }; if (requestedEditor.value == 'business') editBusiness(); else if (requestedEditor.value == 'history' && person != null) await showHistory(person); else { edit(requestedEditor.value, person, channel); profileName.value = store.value!.name; profileAddress.value = store.value!.address; profilePhone.value = store.value!.publicPhone } } }
onShow(() => { pageVisible = true; showPage() })
onHide(() => { pageVisible = false })
watch((): boolean => session.authenticated, (_authenticated: boolean) => { if (pageVisible) showPage() })
</script>
<style>
@import '../../styles/crm.css';
</style>
