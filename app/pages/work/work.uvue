<template>
  <scroll-view class="sw-page" direction="vertical"><view class="me-content">
    <template v-if="view == 'info'">
      <text class="me-title">{{ session.displayName }}</text><text class="me-note">公司统一维护的个人资料</text>
      <view class="me-row me-spacer"><text class="me-note info-label">姓名</text><text class="me-label sw-grow">{{ session.displayName }}</text></view>
      <view class="me-row"><text class="me-note info-label">公司</text><text class="me-label sw-grow">{{ session.tenantName }}</text></view>
      <view class="me-row"><text class="me-note info-label">账号</text><text class="me-label sw-grow">{{ session.username }}</text></view>
      <view v-if="canReadSalesProfile" class="me-row"><text class="me-note info-label">工号</text><text class="me-label sw-grow">{{ salesProfile.employeeCode.length > 0 ? salesProfile.employeeCode : '待确认' }}</text></view>
      <view v-if="canReadSalesProfile && salesProfile.status != 'ACTIVE'" class="me-panel"><text class="me-note">{{ salesProfile.busy ? '正在核验员工身份…' : salesProfile.message }}</text><button v-if="!salesProfile.busy" class="sw-text-button" @click="retryProfile">重新识别身份</button></view>
      <text class="me-note me-spacer">如资料不正确，请联系公司管理员核对员工档案。</text>
    </template>
    <template v-else-if="view == 'about'">
      <view class="about-brand"><image class="about-logo" src="/static/brand/icon-192.png" /><text class="me-title">销售工作台</text><text class="me-note">瑞盖优选 · 销售作业应用</text></view>
      <view class="me-row"><text class="me-label sw-grow">安装版本</text><text class="me-note">{{ appVersion }}</text></view>
      <text class="me-note me-spacer">用于客户拜访、外勤记录与业务协作。账号及业务权限由所属公司管理。</text>
    </template>
    <template v-else>
      <view class="me-row" @click="open('info')"><text class="me-label sw-grow">个人资料</text><image class="me-chevron" src="/static/home/chevron-right.svg" /></view>
      <view class="me-row" @click="permissions"><text class="me-label sw-grow">应用权限</text><image class="me-chevron" src="/static/home/chevron-right.svg" /></view>
      <view class="me-row" @click="open('about')"><text class="me-label sw-grow">关于销售工作台</text><image class="me-chevron" src="/static/home/chevron-right.svg" /></view>
      <text class="me-note settings-note">退出后，本机草稿按账号保留。重新登录原账号可继续处理。</text>
      <text v-if="session.logoutError.length > 0" class="me-error">{{ session.logoutError }}</text>
      <button v-if="session.authenticated || session.logoutState == 'clearing' || session.logoutState == 'failed'" class="me-secondary" :disabled="session.logoutState == 'clearing'" @click="confirmLogout">{{ session.logoutState == 'clearing' ? '正在退出…' : session.logoutState == 'failed' ? '重试退出' : '退出登录' }}</button><button v-else class="me-primary" @click="login">登录公司账号</button>
    </template>
  </view></scroll-view>
</template>
<script setup lang="uts">
import { session, hasPermission } from '../../services/session.uts'
import { logoutCompany } from '../../services/auth.uts'
import { crmRecording } from '../../services/crm-media.uts'
import { salesProfile, syncSalesProfile } from '../../services/sales-profile.uts'
import { loadDrafts } from '../../services/commerce.uts'
const view = ref('account'); const appVersion = ref('—')
const canReadSalesProfile = computed((): boolean => hasPermission('sales:context:read'))
function retryProfile(): void { syncSalesProfile() }
function login(): void { uni.navigateTo({ url: '/pages/login/login' }) }
function open(kind: string): void { uni.navigateTo({ url: '/pages/work/work?view=' + kind }) }
function permissions(): void { uni.navigateTo({ url: '/pages/profile-help/profile-help?view=permissions' }) }
function logout(): void {
  if (crmRecording()) { uni.showToast({ title: '请先停止并保存当前录音再退出登录', icon: 'none' }); return }
  logoutCompany(); loadDrafts()
}
function confirmLogout(): void {
  if (crmRecording()) { uni.showToast({ title: '请先停止并保存当前录音再退出登录', icon: 'none' }); return }
  uni.showModal({ title: '退出当前账号？', content: '本机草稿按账号保留。重新登录原账号可继续处理。', confirmText: '退出', success: (answer) => { if (answer.confirm) logout() } })
}
onLoad((options) => {
  const kind = options?.getString('view') ?? 'account'; view.value = ['info', 'about'].includes(kind) ? kind : 'account'
  uni.setNavigationBarTitle({ title: view.value == 'info' ? '个人资料' : view.value == 'about' ? '关于销售工作台' : '设置' })
  if (view.value == 'about') appVersion.value = uni.getAppBaseInfo().appVersion ?? '未知'
})
onShow(() => { if (view.value == 'info' && canReadSalesProfile.value) syncSalesProfile() })
</script>
<style>
@import '../../styles/profile-ui.css';
.info-label { width: 76px; }
.settings-note { margin-top: 40px; }
.about-brand { align-items: center; padding: 36px 0; }
.about-logo { width: 64px; height: 64px; border-radius: 14px; }
</style>
