<template>
  <view class="sw-page">
    <scroll-view class="statement-scroll" direction="vertical">
      <view class="statement-content">
        <text v-if="loading" class="statement-muted">正在读取…</text>
        <text v-if="error.length > 0" class="statement-error">{{ error }}</text>
        <button v-if="error.length > 0 && !ready" class="sw-text-button" @click="load">重试</button>
        <template v-if="ready">
          <view class="statement-status"><text class="statement-status-text">{{ statusLabel }}</text></view>
          <text class="statement-title">{{ title }}</text>
          <view class="statement-date"><image class="statement-icon" src="/static/home/calendar.svg" /><text class="statement-date-text">{{ date }} {{ evidenceTime }}</text></view>
          <text v-if="kind == 'TRACK_GAP'" class="statement-context">检测时该时段未收到连续有效位置。</text>
          <view v-if="history.length > 0" class="statement-history"><text class="statement-section">说明与处理</text><view v-for="event in history" :key="event.id" class="statement-event"><view class="statement-event-heading"><text class="statement-event-title">{{ event.employee ? '我的说明' : '风控反馈' }}</text><text class="statement-muted">{{ event.time }}</text></view><text class="statement-event-note">{{ event.note }}</text></view></view>
          <view class="statement-reason"><text class="statement-label">原因</text><picker class="statement-picker" :range="reasons" :value="reasonIndex" @change="selectReason"><view class="statement-picker-inner"><text class="statement-picker-text">{{ reasonLabel }}</text><image class="statement-chevron" src="/static/home/chevron-right.svg" /></view></picker></view>
          <textarea v-model="note" class="statement-input" placeholder="填写实际情况" :maxlength="1900" :disabled="submitting" />
        </template>
      </view>
    </scroll-view>
    <view v-if="ready" class="statement-footer"><button class="statement-submit" :disabled="submitting || note.trim().length == 0" :loading="submitting" @click="submit">{{ submitting ? '提交中' : '提交说明' }}</button></view>
  </view>
</template>
<script setup lang="uts">
import { session, requireSession } from '../../services/session.uts'
import { crmOwner, crmToday, crmMessage } from '../../services/crm.uts'
import { attendanceClock } from '../../services/attendance.uts'
import { readOwnFieldCases, readStatementDraft, submitFieldStatement, fieldCaseStatus, FieldCase, FieldCaseEvent } from '../../services/fieldwork-review.uts'
type StatementHistory = { id: string, employee: boolean, note: string, time: string }
const id = ref(''); const date = ref(crmToday()); const item = ref<FieldCase | null>(null)
const loading = ref(false); const submitting = ref(false); const error = ref(''); const note = ref(''); const reasonIndex = ref(0)
const reasons: string[] = ['请选择', '地下室信号弱', '网络中断', '定位权限或系统限制', '设备临时异常', '其他']
const ready = computed((): boolean => item.value != null)
const title = computed((): string => item.value?.title ?? '')
const kind = computed((): string => item.value?.kind ?? '')
const statusLabel = computed((): string => fieldCaseStatus(item.value?.status ?? ''))
const reasonLabel = computed((): string => reasons[reasonIndex.value])
const evidenceTime = computed((): string => {
  const evidence = JSON.parseObject(item.value?.evidence ?? '{}')
  const from = evidence?.getString('from') ?? ''; const to = evidence?.getString('to') ?? ''
  return from.length > 0 ? attendanceClock(from) + '–' + attendanceClock(to) : ''
})
const history = computed((): StatementHistory[] => (item.value?.events ?? [] as FieldCaseEvent[]).map((event: FieldCaseEvent): StatementHistory => ({ id: event.id, employee: event.employee, note: event.note, time: event.createdAt.substring(0, 10) + ' ' + attendanceClock(event.createdAt) } as StatementHistory)))
let generation = 0
async function load(): Promise<void> {
  if (!requireSession() || id.value.length == 0) return
  const version = ++generation; const owner = crmOwner(); loading.value = true; error.value = ''
  try {
    const rows = await readOwnFieldCases(date.value)
    const draft = await readStatementDraft(id.value)
    if (version != generation || owner != crmOwner()) return
    item.value = rows.find((row: FieldCase): boolean => row.id == id.value) ?? null
    if (item.value == null) throw new Error('该核查事项已不可查看')
    if (draft.length > 0) { note.value = draft; reasonIndex.value = 0 }
  } catch (e) { if (version == generation && owner == crmOwner()) error.value = crmMessage(e) }
  finally { if (version == generation) loading.value = false }
}
function selectReason(event: UniPickerChangeEvent): void { reasonIndex.value = parseInt(event.detail.value as string) }
async function submit(): Promise<void> {
  if (submitting.value || item.value == null) return
  const owner = crmOwner(); submitting.value = true; error.value = ''
  try {
    const text = (reasonIndex.value > 0 ? reasonLabel.value + '：' : '') + note.value.trim()
    const updated = await submitFieldStatement(id.value, text)
    if (owner != crmOwner()) return
    item.value = updated; note.value = ''; reasonIndex.value = 0
    uni.showToast({ title: '说明已提交', icon: 'success' })
  } catch (e) { if (owner == crmOwner()) error.value = crmMessage(e) }
  finally { submitting.value = false }
}
onLoad((options) => { id.value = options?.getString('id') ?? ''; date.value = options?.getString('date') ?? crmToday(); load() })
onUnload(() => { generation++; item.value = null; note.value = '' })
watch((): string => crmOwner(), (_owner: string) => { generation++; item.value = null; note.value = ''; if (!session.authenticated) uni.reLaunch({ url: '/pages/login/login' }) })
</script>
<style>
.statement-scroll { flex: 1; }
.statement-content { padding: 20px; }
.statement-status { align-self: flex-start; background-color: #fff1e6; border-radius: 5px; padding: 4px 10px; margin-bottom: 12px; }
.statement-status-text { color: #b45125; font-size: 13px; font-weight: 600; }
.statement-title { color: #24282d; font-size: 26px; line-height: 34px; font-weight: 600; }
.statement-date { flex-direction: row; align-items: center; margin-top: 18px; margin-bottom: 20px; }
.statement-icon { width: 20px; height: 20px; margin-right: 10px; }
.statement-date-text { color: #343a40; font-size: 15px; }
.statement-context { color: #343a40; font-size: 15px; line-height: 24px; padding: 18px 0; border-top-width: 1px; border-top-color: #e5e7eb; }
.statement-history { margin-top: 12px; }
.statement-section { font-size: 17px; font-weight: 600; color: #24282d; margin-bottom: 8px; }
.statement-event { padding: 12px 0; border-bottom-width: 1px; border-bottom-color: #e5e7eb; }
.statement-event-heading { flex-direction: row; justify-content: space-between; margin-bottom: 6px; }
.statement-event-title { font-size: 13px; color: #626970; }
.statement-event-note { font-size: 15px; line-height: 24px; color: #343a40; }
.statement-reason { flex-direction: row; align-items: center; margin-top: 22px; margin-bottom: 16px; }
.statement-label { flex: 1; font-size: 18px; font-weight: 600; color: #24282d; }
.statement-picker { width: 228px; }
.statement-picker-inner { flex-direction: row; align-items: center; padding: 10px 12px; border-width: 1px; border-color: #dadddf; border-radius: 7px; }
.statement-picker-text { flex: 1; font-size: 15px; color: #343a40; }
.statement-chevron { width: 16px; height: 16px; transform: rotate(90deg); }
.statement-input { width: 100%; height: 144px; padding: 14px; font-size: 16px; color: #24282d; background-color: #f5f6f7; border-width: 1px; border-color: #dadddf; border-radius: 8px; }
.statement-muted { font-size: 12px; color: #626970; }
.statement-error { font-size: 13px; color: #b45125; margin-bottom: 12px; }
.statement-footer { padding: 12px 20px 24px; background-color: #ffffff; }
.statement-submit { height: 50px; line-height: 50px; padding: 0; background-color: #b45125; color: #ffffff; font-size: 17px; font-weight: 600; border-radius: 9px; }
</style>
