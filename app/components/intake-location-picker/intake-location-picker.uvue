<template>
  <view class="sw-page i-page">
    <view class="i-content"><view class="sw-between"><text class="i-name">确认门店位置</text><button class="i-link" @click="close">返回</button></view><view class="c-search"><input class="c-input" v-model="keyword" placeholder="搜索道路、建筑或门店" confirm-type="search" @confirm="search" /><button class="i-link" :disabled="busy" @click="search">搜索</button></view></view>
    <scroll-view class="sw-grow" direction="vertical"><view class="i-content">
      <view v-if="point != null" class="location-map"><store-location-map :longitude="point!.longitude" :latitude="point!.latitude" :selectable="true" @pick="pick" /></view>
      <view class="sw-between"><text class="i-caption sw-grow">拖动地图后点选门店位置</text><button class="i-link" :disabled="busy" @click="locate">当前位置</button></view>
      <text v-if="point != null" class="c-text">{{ point!.address }}</text>
      <text v-if="busy" class="i-caption">正在获取位置…</text><view v-if="error.length > 0" class="c-error"><text class="c-error-text">{{ error }}</text></view>
      <view v-for="row in results" :key="row.poi.id" class="i-row" @click="select(row)"><text class="i-name">{{ row.poi.name }}</text><text class="i-address">{{ row.poi.address }}</text></view>
    </view></scroll-view>
    <view class="i-footer"><button class="i-primary" :disabled="busy || point == null || error.length > 0" @click="confirm">使用此位置</button></view>
  </view>
</template>
<script setup lang="uts">
import { crmOwner, crmMessage } from '../../services/crm.uts'
import { IntakePoint, IntakeCandidate, intakeDiscover, intakeResolve, intakeDevicePoint } from '../../services/store-intake.uts'
type LocationPickerProps = { initial: IntakePoint | null, area: string }
const props = defineProps<LocationPickerProps>()
const emit = defineEmits<{ (event: 'selected', point: IntakePoint): void; (event: 'close'): void }>()
const point = ref<IntakePoint | null>(props.initial); const busy = ref(false); const error = ref(''); const keyword = ref(''); const results = ref<IntakeCandidate[]>([])
let generation = 0; const account = crmOwner()
function current(request: number): boolean { return request == generation && account == crmOwner() }
async function locate(): Promise<void> { if (busy.value) return; const request = ++generation; busy.value = true; error.value = ''; try { const p = await intakeDevicePoint(); if (current(request)) point.value = p } catch (e) { if (current(request)) error.value = crmMessage(e) } finally { if (current(request)) busy.value = false } }
async function pick(longitude: number, latitude: number): Promise<void> { const request = ++generation; busy.value = true; error.value = ''; results.value = []; try { const p = await intakeResolve(longitude, latitude, 'GCJ02'); if (current(request)) point.value = p } catch (e) { if (current(request)) error.value = crmMessage(e) } finally { if (current(request)) busy.value = false } }
async function search(): Promise<void> { if (busy.value) return; if (keyword.value.trim().length == 0) { error.value = '请输入门店或地址关键词'; return }; const request = ++generation; busy.value = true; error.value = ''; results.value = []; try { const rows = await intakeDiscover(keyword.value, props.area, point.value, 5000); if (!current(request)) return; results.value = rows; if (rows.length == 0) error.value = '未找到匹配位置，可点选地图或调整关键词' } catch (e) { if (current(request)) error.value = crmMessage(e) } finally { if (current(request)) busy.value = false } }
function select(row: IntakeCandidate): void { const p = row.poi; generation++; busy.value = false; point.value = { longitude: p.longitude, latitude: p.latitude, area: p.area, address: p.address } as IntakePoint; results.value = []; error.value = '' }
function close(): void { generation++; emit('close') }
function confirm(): void { if (!busy.value && point.value != null && error.value.length == 0 && account == crmOwner()) emit('selected', point.value!) }
onMounted(() => { if (point.value == null) locate() }); onUnmounted(() => { generation++ })
</script>
<style>
@import '../../styles/store-intake.css';
.location-map { height: 340px; border-radius: 8px; overflow: hidden; }
</style>
