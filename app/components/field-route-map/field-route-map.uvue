<template>
  <view class="route-map">
    <!-- #ifdef APP-ANDROID || APP-IOS -->
    <amap v-if="consented" :id="mapId" class="route-native" :latitude="initialCenter.latitude" :longitude="initialCenter.longitude" :scale="initialScale" :markers="amapMarkers" :polylines="amapLines" :include-points="initialBounds" :show-location="showCurrent && locationAllowed" :show-scale="true" :enable-poi="true" :enable-rotate="false" @markertap="selectMarker" />
    <view v-if="consented" class="route-controls">
      <view class="route-control" :aria-label="fullscreen ? '退出全屏' : '全屏查看地图'" @click="toggleFullscreen">
        <view class="route-control-face" hover-class="route-control-pressed">
          <image class="route-control-icon" :src="fullscreen ? '/static/fieldwork/minimize.svg' : '/static/fieldwork/maximize.svg'" />
        </view>
      </view>
      <view class="route-control" aria-label="轨迹概览" @click="fitOverview">
        <view class="route-control-face" hover-class="route-control-pressed">
          <image class="route-control-icon" src="/static/fieldwork/overview.svg" />
        </view>
      </view>
      <view v-if="showCurrent" class="route-control" aria-label="回到当前位置" @click="moveToCurrent">
        <view class="route-control-face" hover-class="route-control-pressed">
          <image class="route-control-icon" src="/static/fieldwork/locate.svg" />
        </view>
      </view>
    </view>
    <view v-else class="route-consent">
      <text class="route-title">查看轨迹地图</text>
      <text class="route-copy">高德地图 SDK 会处理设备、网络及地图位置信息，用于地图展示与安全保障。</text>
      <text class="route-policy" @click="openPrivacy">高德 SDK 隐私政策</text>
      <button class="route-enable" @click="agree">同意并查看</button>
    </view>
    <!-- #endif -->
    <!-- #ifndef APP-ANDROID || APP-IOS -->
    <view class="route-consent"><text class="route-copy">此版本暂不支持地图，作业记录可在下方查看</text></view>
    <!-- #endif -->
  </view>
</template>
<script setup lang="uts">
import { FieldLine, FieldMarker, FieldPoint, visibleFieldLines } from '../../services/fieldwork.uts'
// The provider boundary owns SDK consent and types; mileage remains server-calculated.
// #ifdef APP-ANDROID
import { fieldMarkerIcon } from './marker-icon.uts'
import Intent from 'android.content.Intent'
import Uri from 'android.net.Uri'
// #endif
// #ifdef APP-IOS
import { openMapPrivacy } from '../../uni_modules/uni-map-amap'
// #endif
// #ifdef APP-ANDROID || APP-IOS
import { createAmapContext, convertGpsMapPoint } from '../../uni_modules/uni-map-amap'
import { AmapMarker, AmapMapMarkerLabel, AmapAnchor, AmapLocationObject, Polyline as AmapPolyline, MapContextIncludePointsOptions, MapContextMoveToLocationOptions, MapContextFail } from '../../uni_modules/uni-map-amap/utssdk/interface.uts'
import { UniMapMarkerTapEvent as AmapMarkerTapEvent } from '../../uni_modules/uni-map-amap/components/amap/global.uts'
// #endif
type RouteMapProps = { owner: string, points: FieldPoint[], lines: FieldLine[], localLines: FieldLine[], localTail: FieldPoint | null, focus: FieldPoint | null, showCurrent: boolean, markers: FieldMarker[], fullscreen: boolean }
const props = defineProps<RouteMapProps>()
const emit = defineEmits<{ (event: 'select', markerId: number): void; (event: 'fullscreen'): void; (event: 'clear-selection'): void }>()
function toggleFullscreen(): void { emit('fullscreen') }
// #ifdef APP-ANDROID || APP-IOS
const consented = ref(false)
const mapId = 'fieldwork-route-map'
const converted = new Map<number, FieldPoint>()
const initialCenter = ref<AmapLocationObject>({ latitude: 35, longitude: 104 } as AmapLocationObject)
const initialScale = ref(17)
const initialBounds = ref<AmapLocationObject[] | null>(null)
const locationAllowed = ref(false)
function openPrivacy(): void {
  try {
    // #ifdef APP-IOS
    openMapPrivacy()
    // #endif
    // #ifdef APP-ANDROID
    const intent = new Intent(Intent.ACTION_VIEW, Uri.parse('https://lbs.amap.com/pages/privacy/'))
    UTSAndroid.getUniActivity()!.startActivity(intent)
    // #endif
  } catch (_) { uni.showToast({ title: '暂时无法打开隐私政策，请稍后重试', icon: 'none' }) }
}
function selectMarker(event: AmapMarkerTapEvent): void { emit('select', event.detail?.markerId ?? 0) }
function mapPoint(raw: FieldPoint): FieldPoint | null {
  if (!consented.value) return null
  const cached = converted.get(raw.time)
  if (cached != null) return cached
  try {
    const result = convertGpsMapPoint(raw.latitude, raw.longitude)
    if (result == null) return null
    const point = { latitude: result.latitude, longitude: result.longitude, time: raw.time } as FieldPoint
    if (converted.size >= 2048) converted.clear()
    converted.set(raw.time, point)
    return point
  } catch (_) { return null }
}
function overviewBounds(): AmapLocationObject[] {
  const points = props.points.slice()
  for (const line of props.localLines) {
    for (const raw of line.points) {
      const point = mapPoint(raw)
      if (point != null) points.push(point)
    }
  }
  if (points.length == 0 && props.localTail != null) {
    const point = mapPoint(props.localTail!)
    if (point != null) points.push(point)
  }
  if (points.length == 0) return [] as AmapLocationObject[]
  let south = points[0].latitude; let north = south
  let west = points[0].longitude; let east = west
  for (const point of points) {
    south = Math.min(south, point.latitude); north = Math.max(north, point.latitude)
    west = Math.min(west, point.longitude); east = Math.max(east, point.longitude)
  }
  const corner = { latitude: south, longitude: west } as AmapLocationObject
  if (south == north && west == east) return [corner] as AmapLocationObject[]
  return [corner, { latitude: north, longitude: east } as AmapLocationObject] as AmapLocationObject[]
}
function prepareInitialView(): void {
  const bounds = overviewBounds()
  const focus = props.focus
  if (focus != null) initialCenter.value = { latitude: focus.latitude, longitude: focus.longitude } as AmapLocationObject
  else if (bounds.length == 1) initialCenter.value = bounds[0]
  else if (bounds.length == 2) initialCenter.value = {
    latitude: (bounds[0].latitude + bounds[1].latitude) / 2,
    longitude: (bounds[0].longitude + bounds[1].longitude) / 2
  } as AmapLocationObject
  initialScale.value = bounds.length == 0 && focus == null ? 4 : 17
  initialBounds.value = focus == null && bounds.length == 2 ? bounds : null
}
function consentKey(): string { return 'rigour.amap.consent.v1|' + props.owner }
function readConsent(): void {
  converted.clear()
  consented.value = false
  if (props.owner.length == 0) return
  try { consented.value = uni.getStorageSync(consentKey()) == true } catch (_) { }
  if (consented.value) prepareInitialView()
}
function agree(): void {
  if (props.owner.length == 0) return
  try { uni.setStorageSync(consentKey(), true) }
  catch (_) { uni.showToast({ title: '本机设置未保存，下次需重新确认', icon: 'none' }) }
  consented.value = true
  prepareInitialView()
}
function refreshLocationPermission(): void {
  locationAllowed.value = props.showCurrent && uni.getAppAuthorizeSetting().locationAuthorized == 'authorized'
}
function fitOverview(): void {
  const bounds = overviewBounds()
  if (bounds.length == 0) return
  const map = createAmapContext(mapId, null)
  if (map == null) { uni.showToast({ title: '地图加载中，请稍后重试', icon: 'none' }); return }
  const options = { points: bounds, success: (_: any) => { emit('clear-selection') } } as MapContextIncludePointsOptions
  map.includePoints(options)
}
function moveToCurrent(): void {
  refreshLocationPermission()
  if (!locationAllowed.value) { uni.showToast({ title: '请在系统设置中允许定位', icon: 'none' }); return }
  const map = createAmapContext(mapId, null)
  if (map == null) { uni.showToast({ title: '地图加载中，请稍后重试', icon: 'none' }); return }
  const options = {
    success: (_: any) => { emit('clear-selection') },
    fail: (_: MapContextFail) => { uni.showToast({ title: '当前位置暂不可用，请稍后重试', icon: 'none' }) }
  } as MapContextMoveToLocationOptions
  map.moveToLocation(options)
}
const amapLines = computed((): AmapPolyline[] => {
  const routes = props.lines.slice()
  for (const route of props.localLines) {
    const points = [] as FieldPoint[]
    for (const raw of route.points) {
      const point = mapPoint(raw)
      if (point != null) points.push(point)
    }
    if (points.length == route.points.length) routes.push({ points, color: route.color, width: route.width, arrow: route.arrow } as FieldLine)
  }
  return visibleFieldLines(routes).map((line): AmapPolyline => ({
    points: line.points.map((point): AmapLocationObject => ({ latitude: point.latitude, longitude: point.longitude } as AmapLocationObject)),
    color: line.color, width: line.width, arrowLine: line.arrow, arrowIconPath: '/static/fieldwork/route-arrow.png', borderColor: '#ffffff', borderWidth: 1
  } as AmapPolyline))
})
const amapMarkers = computed((): AmapMarker[] => props.markers.map((marker: FieldMarker): AmapMarker => {
  // Opposing flags keep nearby departure and arrival visible without moving their geographic anchors.
  const mirror = marker.kind == 'start' && props.markers.some((other: FieldMarker): boolean => other.kind == 'end' && Math.abs(other.latitude - marker.latitude) < 0.0003 && Math.abs(other.longitude - marker.longitude) < 0.0003)
  // #ifdef APP-ANDROID
  const icon = fieldMarkerIcon(marker, mirror)
  return { id: marker.id, latitude: marker.latitude, longitude: marker.longitude, iconPath: icon.path, width: icon.width, height: icon.height, anchor: { x: icon.anchorX, y: icon.anchorY } as AmapAnchor } as AmapMarker
  // #endif
  // #ifdef APP-IOS
  if (marker.kind == 'visit') {
    const label = { content: marker.sequences.join('·'), color: '#ffffff', fontSize: 12, bgColor: '#e96326', borderRadius: 8, padding: 3, x: 12, y: 0 } as AmapMapMarkerLabel
    return { id: marker.id, latitude: marker.latitude, longitude: marker.longitude, iconPath: '/static/fieldwork/visit.png', width: 24, height: 24, anchor: { x: 0.5, y: 0.5 } as AmapAnchor, label } as AmapMarker
  }
  const path = marker.kind == 'end' ? 'check-out' : mirror ? 'check-in-left' : 'check-in'
  return { id: marker.id, latitude: marker.latitude, longitude: marker.longitude, iconPath: '/static/fieldwork/' + path + '.png', width: 36, height: 38, anchor: { x: mirror ? 29.0 / 36 : 7.0 / 36, y: 33.0 / 38 } as AmapAnchor } as AmapMarker
  // #endif
}))
onMounted(() => { readConsent(); refreshLocationPermission() })
watch((): string => props.owner, (_owner: string) => readConsent())
watch((): boolean => props.showCurrent, (_visible: boolean) => refreshLocationPermission())
watch((): FieldPoint | null => props.focus, (point: FieldPoint | null, previous: FieldPoint | null) => {
  if (!consented.value || point == null) return
  if (previous != null && point.latitude == previous.latitude && point.longitude == previous.longitude) return
  const options = { latitude: point.latitude, longitude: point.longitude } as MapContextMoveToLocationOptions
  createAmapContext(mapId, null)?.moveToLocation(options)
})
// #endif
</script>
<style>
.route-map { width: 100%; height: 100%; position: relative; }
.route-native { width: 100%; height: 100%; }
.route-controls { position: absolute; top: 4px; right: 4px; }
.route-control { width: 48px; height: 48px; align-items: center; justify-content: center; }
.route-control-face { width: 34px; height: 34px; border-width: 1px; border-style: solid; border-color: #e2e5e9; border-radius: 8px; background-color: #ffffff; align-items: center; justify-content: center; }
.route-control-pressed { background-color: #eef1f4; }
.route-control-icon { width: 22px; height: 22px; }
.route-consent { flex: 1; align-items: center; justify-content: center; padding: 16px 20px; }
.route-title { color: #24282d; font-size: 16px; font-weight: 600; margin-bottom: 8px; }
.route-copy { color: #626970; font-size: 12px; line-height: 19px; text-align: center; }
.route-policy { color: #b65129; font-size: 12px; line-height: 44px; }
.route-enable { height: 40px; line-height: 40px; font-size: 14px; padding: 0 20px; margin: 0; border-width: 0; border-radius: 8px; color: #ffffff; background-color: #b65129; }
</style>
