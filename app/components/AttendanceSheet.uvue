<template>
  <view v-if="visible" class="attendance-overlay" @click="close">
    <view class="attendance-sheet" @click.stop>
      <view class="attendance-heading"><text class="attendance-title">{{ sheetTitle }}</text><button class="attendance-close" aria-label="关闭上下班面板" @click="close"><image class="attendance-icon" src="/static/visits/x.svg" /></button></view>
      <view class="attendance-row"><image class="attendance-icon" src="/static/home/calendar-outline.svg" /><text class="attendance-label">上班签到</text><text class="attendance-value">{{ checkInTime }}</text></view>
      <view v-if="finished" class="attendance-row"><image class="attendance-icon" src="/static/home/calendar.svg" /><text class="attendance-label">下班签退</text><text class="attendance-value">{{ checkOutTime }}</text></view>
      <view class="attendance-row"><image class="attendance-icon" src="/static/home/map-pin.svg" /><text class="attendance-label">当前位置</text><button class="attendance-link" :disabled="locating || attendance.busy" @click="locate">{{ locating ? '定位中…' : locationReady ? '重新定位' : '获取位置' }}</button></view>
      <view v-if="locationReady" class="attendance-row"><view class="attendance-dot" /><text class="attendance-label">{{ accuracyLabel }}</text><text class="attendance-secondary">{{ locatedAt }}</text></view>
      <view class="attendance-row"><image class="attendance-icon" src="/static/home/contact-round.svg" /><text class="attendance-label">当前设备</text><text class="attendance-secondary">本机 · 未核验</text></view>
      <view class="attendance-row attendance-record" hover-class="sw-pressed" @click="records"><image class="attendance-icon" src="/static/home/calendar-outline.svg" /><text class="attendance-label">今日外勤记录</text><image class="attendance-chevron" src="/static/home/chevron-right.svg" /></view>
      <view v-if="active" class="attendance-row"><image class="attendance-icon" src="/static/home/map-pin.svg" /><text class="attendance-label">工作轨迹</text><text v-if="fieldTracking.active" class="attendance-secondary">记录中</text><button v-else class="attendance-link" @click="retryTracking">检查定位</button></view>
      <text v-if="fieldTracking.message.length > 0" class="attendance-error">{{ fieldTracking.message }}</text>
      <text v-if="refreshing" class="attendance-secondary">正在确认上下班状态…</text>
      <text v-if="error.length > 0" class="attendance-error">{{ error }}</text>
      <button v-if="!ready && !refreshing" class="attendance-link" @click="loadState">重新读取状态</button>
      <button v-if="visitConflict" class="attendance-submit" @click="currentVisit">返回当前拜访</button>
      <button v-else-if="canPunch" class="attendance-submit" :disabled="attendance.busy || locating" :loading="attendance.busy" @click="submit">{{ actionLabel }}</button>
    </view>
  </view>
</template>
<script setup lang="uts">
import { fieldTracking, retryFieldTracking } from '../services/field-tracking.uts'
import { attendance, refreshAttendance, punchAttendance, attendanceClock } from '../services/attendance.uts'
import { crmLocation, crmMessage, crmOwner, crmToday } from '../services/crm.uts'
import { crmRecording } from '../services/crm-media.uts'
import { hasActiveVisitRecording } from '../services/visits.uts'
import { hasPermission } from '../services/session.uts'
const props = defineProps({ visible: { type: Boolean, default: false } })
const emit = defineEmits(['close', 'changed'])
const error = ref('')
const locating = ref(false)
const locationReady = ref(false)
const accuracyLabel = ref('')
const locatedAt = ref('')
const visitConflict = ref(false)
const refreshing = ref(false)
const ready = ref(false)
let refreshVersion = 0
const active = computed((): boolean => attendance.day?.status == 'ACTIVE')
const finished = computed((): boolean => attendance.day?.status == 'FINISHED')
const checkInTime = computed((): string => attendanceClock(attendance.day?.checkedInAt ?? ''))
const checkOutTime = computed((): string => attendanceClock(attendance.day?.checkedOutAt ?? ''))
const canPunch = computed((): boolean => hasPermission('sales:work-day:write') && ready.value)
const sheetTitle = computed((): string => active.value ? '下班签退' : finished.value ? '今日上下班' : '上班签到')
const actionLabel = computed((): string => attendance.busy ? attendance.phase : attendance.pending ? '重试同步' : active.value ? '下班签退' : finished.value ? '再次签到' : '上班签到')
function close(): void { if (!attendance.busy) emit('close') }
function retryTracking(): void { retryFieldTracking() }
function records(): void { close(); uni.navigateTo({ url: '/pages/fieldwork/fieldwork?date=' + (attendance.businessDate.length > 0 ? attendance.businessDate : crmToday()) }) }
function currentVisit(): void { close(); uni.switchTab({ url: '/pages/visits/visits' }) }
async function locate(): Promise<void> {
  if (locating.value) return
  locating.value = true; error.value = ''; const owner = crmOwner()
  try {
    const point = await crmLocation()
    if (owner != crmOwner() || !props.visible) return
    locationReady.value = true; accuracyLabel.value = '定位精度 ±' + Math.round(point.getNumber('accuracyMeters') ?? 0).toString() + '米'; locatedAt.value = attendanceClock(new Date().toISOString()) + ' 采集'
  } catch (e) { if (owner == crmOwner()) error.value = crmMessage(e) }
  finally { locating.value = false }
}
async function submit(): Promise<void> {
  if (!canPunch.value || attendance.busy || locating.value) return
  visitConflict.value = false; error.value = ''
  if (active.value && (crmRecording() || hasActiveVisitRecording())) { visitConflict.value = true; error.value = '请先完成当前拜访'; return }
  const checkOut = active.value; const owner = crmOwner()
  try {
    await punchAttendance(checkOut)
    if (owner != crmOwner()) return
    emit('changed'); uni.showToast({ title: checkOut ? '签退成功' : '签到成功', icon: 'none' }); close()
  } catch (e) {
    if (owner != crmOwner()) return
    error.value = crmMessage(e)
    if (error.value.includes('进行中的拜访') || error.value.includes('先完成当前拜访')) visitConflict.value = true
  }
}
async function loadState(): Promise<void> {
  const version = ++refreshVersion; const owner = crmOwner()
  ready.value = false; refreshing.value = true; error.value = ''
  try {
    await refreshAttendance(true)
    if (version == refreshVersion && owner == crmOwner() && props.visible) ready.value = true
  } catch (e) {
    if (version == refreshVersion && owner == crmOwner() && props.visible) error.value = crmMessage(e)
  } finally { if (version == refreshVersion) refreshing.value = false }
}
watch((): boolean => props.visible, (value: boolean) => {
  if (!value) { refreshVersion++; ready.value = false; refreshing.value = false; return }
  error.value = ''; visitConflict.value = false; locationReady.value = false
  loadState()
})
watch((): string => crmOwner(), (_owner: string) => { refreshVersion++; ready.value = false; refreshing.value = false; error.value = ''; locationReady.value = false; visitConflict.value = false; emit('close') })
</script>
<style>
.attendance-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.36); justify-content: flex-end; }
.attendance-sheet { background-color: #ffffff; border-top-left-radius: 20px; border-top-right-radius: 20px; padding: 12px 20px 20px; }
.attendance-heading { flex-direction: row; align-items: center; margin-bottom: 8px; }
.attendance-title { flex: 1; color: #24282d; font-size: 22px; font-weight: 600; }
.attendance-close { width: 48px; height: 48px; padding: 12px; margin: 0 -12px 0 0; border-width: 0; background-color: transparent; }
.attendance-icon { width: 22px; height: 22px; margin-right: 12px; }
.attendance-row { min-height: 52px; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: #e8eaec; }
.attendance-label { flex: 1; color: #24282d; font-size: 15px; }
.attendance-value { color: #24282d; font-size: 16px; }
.attendance-secondary { color: #626970; font-size: 13px; }
.attendance-link { margin: 0; padding: 12px 0 12px 12px; background-color: transparent; border-width: 0; font-size: 14px; color: #c64c1c; }
.attendance-dot { width: 10px; height: 10px; border-radius: 5px; background-color: #289c68; margin-left: 6px; margin-right: 18px; }
.attendance-chevron { width: 18px; height: 18px; }
.attendance-record { border-bottom-width: 0; }
.attendance-error { color: #b54721; font-size: 13px; margin-top: 8px; }
.attendance-submit { margin: 20px 0 0; border-width: 0; border-radius: 12px; background-color: #b65028; color: #ffffff; min-height: 50px; line-height: 24px; padding: 13px 16px; font-size: 17px; font-weight: 600; }
</style>
