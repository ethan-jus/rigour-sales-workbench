<script setup lang="uts">
// #ifdef APP
import { handleAuthCallback } from './services/auth.uts'
onLaunch((options) => {
  if (options == null) return
  if (options.appScheme != null) handleAuthCallback(options.appScheme!)
  if (options.appLink != null) handleAuthCallback(options.appLink!)
})
onShow((options) => {
  if (options == null) return
  if (options.appScheme != null) handleAuthCallback(options.appScheme!)
  if (options.appLink != null) handleAuthCallback(options.appLink!)
})
// #endif
// #ifdef WEB
onLaunch(() => {})
// #endif
</script>

<style>
@import "./styles/theme.css";
/* #ifdef WEB */
uni-page-body { min-height: 100%; }
/* #endif */
</style>
