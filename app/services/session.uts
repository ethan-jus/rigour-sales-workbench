import { reactive } from 'vue'

export type SessionState = {
  authenticated: boolean,
  displayName: string,
  username: string,
  userId: string,
  tenantId: string,
  permissions: string[],
  accessToken: string,
  expiresAt: number,
  revision: number,
  tokenVersion: number,
  restoring: boolean,
  refreshing: boolean,
  loginError: string,
  logoutState: string,
  logoutError: string
}

// Access tokens stay in memory. Only refresh credentials use native secure storage.
export const session = reactive({
  authenticated: false, displayName: '', username: '', userId: '', tenantId: '',
  permissions: [] as string[], accessToken: '', expiresAt: 0, revision: 0,
  tokenVersion: 0, restoring: false, refreshing: false, loginError: '',
  logoutState: 'idle', logoutError: ''
} as SessionState)

export function clearSession(): void {
  session.revision += 1
  session.tokenVersion += 1
  session.authenticated = false
  session.displayName = ''
  session.username = ''
  session.userId = ''
  session.tenantId = ''
  session.permissions = [] as string[]
  session.accessToken = ''
  session.expiresAt = 0
  session.restoring = false
  session.refreshing = false
  session.loginError = ''
  session.logoutState = 'idle'
  session.logoutError = ''
}

export function hasPermission(permission: string): boolean {
  return session.authenticated && session.permissions.includes(permission)
}

export function requireSession(): boolean {
  if (session.authenticated) return true
  uni.navigateTo({ url: '/pages/login/login' })
  return false
}
