import { reactive, watch } from 'vue'
import { acquireBackgroundLocation, releaseBackgroundLocation, BackgroundPoint } from './background-location.uts'
import { attendance, refreshAttendance } from './attendance.uts'
import { crmOwner, crmCall, crmObject, crmId, crmMessage } from './crm.uts'
import { session, hasPermission } from './session.uts'
import { fieldStorageScope, readFieldValue, writeFieldValue, fieldStorageDurable } from './field-storage.uts'

type TrackPoint = { id: string, longitude: number, latitude: number, accuracy: number, observedAt: string }
type TrackBatch = { id: string, day: string, session: string, expiresAt: number, sealed: boolean, points: TrackPoint[], normalized: UTSJSONObject[] }
type TrackQueue = { scope: string, owner: string, batches: TrackBatch[] }
type TrackingState = { active: boolean, starting: boolean, message: string, lastPointAt: number, pendingPoints: number }
export const fieldTracking = reactive({ active: false, starting: false, message: '', lastPointAt: 0, pendingPoints: 0 } as TrackingState)
let queue: TrackQueue | null = null
let opening: Promise<TrackQueue> | null = null
let openingOwner = ''
let writes: Promise<void> = Promise.resolve()
let processing = false
let started = false
let generation = 0
let timer = 0
let lastSample = 0
let activeSession = ''
let activeOwner = ''
let askedOwner = ''
let retryAfter = 0
let lastFlush = 0

function activeIdentity(owner: string): boolean { return owner.length > 0 && owner == crmOwner() }
function consentKey(): string { return 'rigour.field.consent.v1.' + encodeURIComponent(fieldStorageScope()) }
function persist(context: TrackQueue): Promise<void> {
  // Serialize snapshots on the native secure-storage executor, never on the UI thread.
  const snapshot = JSON.parseObject(JSON.stringify({ batches: context.batches } as UTSJSONObject))!
  writes = writes.catch((_) => {}).then(async (): Promise<void> => { await writeFieldValue(context.scope, 'track:queue', snapshot) })
  return writes
}
function updatePending(context: TrackQueue): void {
  if (activeIdentity(context.owner)) fieldTracking.pendingPoints = context.batches.reduce((count: number, batch: TrackBatch): number => count + batch.points.length, 0)
}
function parseBatch(row: UTSJSONObject): TrackBatch {
  const points = (row['points'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]
  const id = row.getString('id') ?? ''; const day = row.getString('day') ?? ''; const segment = row.getString('session') ?? ''
  if (id.length == 0 || day.length == 0 || segment.length == 0) throw new Error('本机轨迹队列不完整，原记录已保留')
  return { id, day, session: segment, expiresAt: row.getNumber('expiresAt') ?? 0, sealed: row.getBoolean('sealed') ?? false, points: points.map((point: UTSJSONObject): TrackPoint => ({ id: point.getString('id') ?? '', longitude: point.getNumber('longitude') ?? 0, latitude: point.getNumber('latitude') ?? 0, accuracy: point.getNumber('accuracy') ?? 0, observedAt: point.getString('observedAt') ?? '' } as TrackPoint)), normalized: (row['normalized'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[] } as TrackBatch
}
function openQueue(owner: string): Promise<TrackQueue> {
  if (queue != null && queue!.owner == owner) return Promise.resolve(queue!)
  if (opening != null && openingOwner == owner) return opening!
  const scope = fieldStorageScope(); openingOwner = owner
  const request = readFieldValue(scope, 'track:queue').then((value: UTSJSONObject | null): TrackQueue => {
    if (!activeIdentity(owner)) throw new Error('账号已变更')
    const rows = value == null ? [] as UTSJSONObject[] : (value!['batches'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]
    const context = { scope, owner, batches: rows.map((row: UTSJSONObject): TrackBatch => parseBatch(row)) } as TrackQueue
    queue = context; updatePending(context); return context
  }).finally(() => { if (openingOwner == owner) { opening = null; openingOwner = '' } })
  opening = request; return request
}
export function stopFieldTracking(): void {
  generation++; lastSample = 0; activeSession = ''; activeOwner = ''; fieldTracking.active = false; fieldTracking.starting = false
  releaseBackgroundLocation('fieldwork')
}
function canCapture(): boolean {
  return session.authenticated && hasPermission('sales:location:write') && attendance.locationEnabled
    && attendance.day?.status == 'ACTIVE' && attendance.day!.sessionId.length > 0
    && !attendance.pending && !attendance.busy && Date.now() + attendance.serverOffset < attendance.captureUntil
}
async function flush(context: TrackQueue, force: boolean = false): Promise<void> {
  if (processing || !activeIdentity(context.owner) || Date.now() < retryAfter || !hasPermission('sales:location:write')) return
  if (!force && Date.now() - lastFlush < 60000) return
  const now = Date.now() + attendance.serverOffset
  const batch = context.batches.find((item: TrackBatch): boolean => item.points.length > 0 && item.expiresAt > now)
  if (batch == null) { if (context.batches.length > 0) fieldTracking.message = '部分轨迹超过补传时限，原记录已保留'; return }
  processing = true; lastFlush = Date.now()
  try {
    batch!.sealed = true; await persist(context)
    if (!activeIdentity(context.owner)) return
    for (let index = batch!.normalized.length; index < batch!.points.length; index++) {
      const point = batch!.points[index]
      const converted = crmObject(await crmCall('/sales/work/location/normalize', 'POST', { longitude: point.longitude, latitude: point.latitude, coordinateSystem: 'WGS84' } as UTSJSONObject))
      if (!activeIdentity(context.owner)) return
      const longitude = converted.getNumber('longitude'); const latitude = converted.getNumber('latitude')
      if (longitude == null || latitude == null || converted.getString('coordinateSystem') != 'GCJ02') throw new Error('坐标转换未完成')
      batch!.normalized.push({ deviceEventId: point.id, longitude: longitude!, latitude: latitude!, accuracyMeters: point.accuracy, clientOccurredAt: point.observedAt, source: 'APP_LOCATION_CALLBACK', rawLongitude: point.longitude, rawLatitude: point.latitude, rawCoordinateSystem: 'WGS84' } as UTSJSONObject)
      await persist(context)
    }
    if (!activeIdentity(context.owner)) return
    const receipt = crmObject(await crmCall('/sales/work-days/' + batch!.day + '/location-points:batch', 'POST', { idempotencyKey: batch!.id, locationSessionId: batch!.session, points: batch!.normalized } as UTSJSONObject))
    if (receipt.getString('workDayId') != batch!.day || (receipt.getNumber('acceptedCount') ?? 0) + (receipt.getNumber('duplicateCount') ?? 0) != batch!.points.length || (receipt.getNumber('rejectedCount') ?? 0) > 0) throw new Error('轨迹回执不完整，已保留本机记录')
    if (!activeIdentity(context.owner)) return
    context.batches = context.batches.filter((item: TrackBatch): boolean => item.id != batch!.id)
    await persist(context); updatePending(context); retryAfter = 0
  } catch (e) { if (activeIdentity(context.owner)) { fieldTracking.message = '轨迹待同步'; retryAfter = Date.now() + 30000 } }
  finally { processing = false }
}
async function appendPoint(context: TrackQueue, point: TrackPoint): Promise<void> {
  if (!activeIdentity(context.owner) || !canCapture() || activeSession != attendance.day?.sessionId) return
  if (fieldTracking.pendingPoints >= 10000) { stopFieldTracking(); fieldTracking.message = '本机轨迹待同步，请恢复网络'; return }
  let batch = context.batches.length > 0 ? context.batches[context.batches.length - 1] : null
  if (batch == null || batch!.sealed || batch!.session != activeSession || batch!.points.length >= 20) {
    batch = { id: crmId(), day: attendance.day!.id, session: activeSession, expiresAt: attendance.captureUntil + attendance.offlineDeadline * 60000, sealed: false, points: [], normalized: [] } as TrackBatch
    context.batches.push(batch!)
  }
  batch!.points.push(point); updatePending(context)
  try { await persist(context); if (activeIdentity(context.owner)) { fieldTracking.lastPointAt = Date.parse(point.observedAt); fieldTracking.message = ''; flush(context) } }
  catch (e) { if (activeIdentity(context.owner)) { stopFieldTracking(); fieldTracking.message = '轨迹保存失败，已停止采集' } }
}
async function consent(owner: string): Promise<boolean> {
  if (uni.getStorageSync(consentKey()) == true) return true
  if (askedOwner == owner) return false
  askedOwner = owner
  const accepted = await new Promise<boolean>((resolve) => { uni.showModal({ title: '记录工作轨迹', content: '上班期间记录位置，用于外勤监督。签退后停止采集。', confirmText: '允许记录', cancelText: '暂不开启', success: (result) => resolve(result.confirm), fail: (_) => resolve(false) }) })
  if (!activeIdentity(owner)) return false
  if (accepted) uni.setStorageSync(consentKey(), true)
  return accepted
}
async function reconcile(): Promise<void> {
  if (!canCapture()) { if (fieldTracking.active || fieldTracking.starting) stopFieldTracking(); return }
  const owner = crmOwner(); const segment = attendance.day!.sessionId
  if ((fieldTracking.active || fieldTracking.starting) && activeOwner == owner && activeSession == segment) return
  stopFieldTracking(); const version = generation; activeOwner = owner; activeSession = segment; fieldTracking.starting = true
  try {
    if (!fieldStorageDurable()) { fieldTracking.message = '本机尚未支持离线轨迹保存'; return }
    if (!await consent(owner)) { if (activeIdentity(owner)) fieldTracking.message = '未开启轨迹记录'; return }
    const context = await openQueue(owner)
    if (version != generation || !canCapture()) return
    // #ifdef APP
    await acquireBackgroundLocation('fieldwork', (location: BackgroundPoint) => {
      if (version != generation) return
      if (!activeIdentity(owner) || !canCapture()) { stopFieldTracking(); return }
      const now = Date.now()
      if (now - lastSample < attendance.locationInterval * 1000 || !Number.isFinite(location.latitude) || !Number.isFinite(location.longitude) || !Number.isFinite(location.accuracy) || location.accuracy <= 0) return
      lastSample = now
      // This is callback receipt time; the system API does not provide the GPS fix timestamp.
      appendPoint(context, { id: crmId(), longitude: location.longitude, latitude: location.latitude, accuracy: location.accuracy, observedAt: new Date(now).toISOString() } as TrackPoint)
    }, (message: string) => { if (version == generation && activeIdentity(owner)) { stopFieldTracking(); fieldTracking.message = '定位中断：' + message } })
    // #endif
    if (version != generation) return
    if (!canCapture()) { stopFieldTracking(); return }
    fieldTracking.active = true; fieldTracking.message = ''; lastSample = 0
    flush(context)
  } catch (e) { if (version == generation && activeIdentity(owner)) { stopFieldTracking(); fieldTracking.message = crmMessage(e) } }
  finally { if (version == generation) fieldTracking.starting = false }
}
export async function resumeFieldTracking(): Promise<void> {
  if (!session.authenticated || !hasPermission('sales:context:read')) { stopFieldTracking(); return }
  try {
    const owner = crmOwner()
    await refreshAttendance(true)
    if (!activeIdentity(owner)) return
    if (fieldStorageDurable()) { const context = await openQueue(owner); flush(context, true) }
    await reconcile()
  } catch (_) { fieldTracking.message = '作业状态待确认' }
}
export function retryFieldTracking(): void { askedOwner = ''; retryAfter = 0; lastFlush = 0; resumeFieldTracking() }
export function startFieldTracking(): void {
  if (started) return
  started = true
  watch((): string => crmOwner(), (_owner: string) => { stopFieldTracking(); queue = null; opening = null; openingOwner = ''; retryAfter = 0; lastFlush = 0; askedOwner = ''; fieldTracking.pendingPoints = 0; fieldTracking.lastPointAt = 0; fieldTracking.message = '' })
  watch((): string => (attendance.day?.sessionId ?? '') + '|' + (attendance.day?.status ?? '') + '|' + attendance.pending.toString() + '|' + attendance.busy.toString(), (_state: string) => { reconcile() })
  timer = setInterval(() => {
    if (!canCapture() && (fieldTracking.active || fieldTracking.starting)) stopFieldTracking()
    if (queue != null && activeIdentity(queue!.owner)) flush(queue!)
  }, 15000)
}
