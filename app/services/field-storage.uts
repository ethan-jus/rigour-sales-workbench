import { appEnvironment } from './config.uts'
import { session } from './session.uts'
// #ifdef APP-IOS
import { readProtectedFieldValue as readSecurePayload, writeProtectedFieldValue as writeSecurePayload, clearProtectedFieldValue as clearSecurePayload } from '../uni_modules/rigour-session-keychain'
// #endif
// #ifndef APP-IOS
import { secureStorageSupported, readSecurePayload, writeSecurePayload, clearSecurePayload } from './secure-storage.uts'
// #endif

// Only capture commands belong here. Display snapshots and credentials have separate lifecycles.
const volatileValues = new Map<string, string>()
export function fieldStorageScope(): string {
  if (!session.authenticated) throw new Error('请先登录公司账号')
  return 'rigour.field.v1|' + appEnvironment.environment + '|' + appEnvironment.gatewayOrigin
    + '|' + appEnvironment.issuer + '|' + appEnvironment.clientId + '|' + session.tenantId + '|' + session.userId
}
export function fieldStorageDurable(): boolean {
  // #ifdef APP-IOS
  return true
  // #endif
  // #ifndef APP-IOS
  return secureStorageSupported()
  // #endif
}
export async function readFieldValue(scope: string, key: string): Promise<UTSJSONObject | null> {
  const name = scope + '|' + key
  const raw = fieldStorageDurable()
    ? await new Promise<string | null>((resolve, reject) => { readSecurePayload(name, (value: string | null) => resolve(value), (message) => reject(new Error(message))) })
    : volatileValues.get(name) ?? null
  if (raw == null) return null
  const value = JSON.parseObject(raw!)
  if (value == null) throw new Error('本机作业数据读取失败，原文件已保留')
  return value
}
export async function writeFieldValue(scope: string, key: string, value: UTSJSONObject): Promise<void> {
  const raw = JSON.stringify(value); const name = scope + '|' + key
  if (!fieldStorageDurable()) { volatileValues.set(name, raw); return }
  await new Promise<void>((resolve, reject) => { writeSecurePayload(name, raw, () => resolve(), (message) => reject(new Error(message))) })
}
export async function clearFieldValue(scope: string, key: string): Promise<void> {
  const name = scope + '|' + key
  if (!fieldStorageDurable()) { volatileValues.delete(name); return }
  await new Promise<void>((resolve, reject) => { clearSecurePayload(name, () => resolve(), (message) => reject(new Error(message))) })
}
