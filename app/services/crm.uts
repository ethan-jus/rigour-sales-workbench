import { session } from './session.uts'
import { requestApi, apiErrorMessage } from './api.uts'
import { requestSalesApi } from './sales-profile.uts'
import { requestDeviceLocation, DeviceLocation } from './location.uts'
import { readCustomerSnapshot, refreshCustomerSnapshot, invalidateCustomerCache } from './customer-cache.uts'

export type CrmStore = { id: string, name: string, address: string, displayAddress: string, cooldown: string, publicPhone: string, revision: number, ownerEmployeeId: string, ownershipId: string, pool: string, phase: string, deadline: string, businessStatus: string, claimBlocked: string, lastVisit: string, lastOrder: string, holdReason: string, longitude: number | null, latitude: number | null, coordinateSystem: string, storeType: string | null }
export type CrmMethod = { id: string, type: string, value: string, status: string, revision: number }
export type CrmContact = { id: string, name: string, role: string, primary: boolean, status: string, revision: number, personRevision: number, methods: CrmMethod[] }
export type CrmPage = { items: CrmStore[], total: number, cursor: string }
export type CrmVisit = { visitId: string, captureId: string, storeId: string, ownershipId: string }
export type CrmVisitLocation = { owner: string, requestedAt: number, receivedAt: number, location: UTSJSONObject }
export type CrmVisitRecord = { id: string, captureId: string, ownershipId: string, salespersonId: string, status: string, visitedAt: string, reviewReason: string }

const mutationKeys = new Map<string, string>()
let mutationOwner = ''
export function crmOwner(): string { return session.authenticated ? session.tenantId + ':' + session.userId + ':' + session.revision.toString() + ':' + session.permissions.slice().sort().join(',') : '' }
export function crmId(): string { return 'crm-' + Date.now().toString(36) + '-' + Math.random().toString(36).substring(2, 12) }
export function crmToday(): string { const d = new Date(Date.now() + 8 * 3600000); return d.getUTCFullYear().toString() + '-' + (d.getUTCMonth() + 1).toString().padStart(2, '0') + '-' + d.getUTCDate().toString().padStart(2, '0') }
export function crmCall(path: string, method: string = 'GET', body: UTSJSONObject | null = null): Promise<UTSJSONObject> {
  return new Promise<UTSJSONObject>((resolve, reject) => {
    const owner = crmOwner()
    if (owner.length == 0) { reject(new Error('请先登录公司账号')); return }
    requestApi(path, method, body, (result) => { if (owner != crmOwner()) { reject(new Error('账号已变更')); return }; resolve(result) }, (message) => reject(new Error(message)))
  })
}
export function crmObject(response: UTSJSONObject): UTSJSONObject {
  const data = response.getJSON('data')
  if (data == null) throw new Error('服务返回的数据不完整，请刷新重试')
  return data
}
export function crmValidateCount(data: UTSJSONObject, key: string, nullable: boolean = false): void {
  if (nullable && data[key] == null) return
  const count = data.getNumber(key)
  if (count == null || !Number.isFinite(count!) || count! < 0 || Math.floor(count!) != count!) throw new Error('服务返回的数量不完整，请刷新重试')
}
export function crmValidatePage(data: UTSJSONObject): void {
  crmValidateCount(data, 'total')
  if (!Array.isArray(data['items']) || (data['nextCursor'] != null && data.getString('nextCursor') == null)) throw new Error('服务返回的列表不完整，请刷新重试')
  const rows = data['items'] as UTSJSONObject[]
  for (const row of rows) {
    if (row == null || typeof row != 'object' || Array.isArray(row) || (row.getString('id') ?? '').trim().length == 0) throw new Error('服务返回的客户资料不完整，请刷新重试')
  }
}
export function crmDisplayRead(path: string, validate: (data: UTSJSONObject) => void): Promise<UTSJSONObject> {
  return refreshCustomerSnapshot(path, async (): Promise<UTSJSONObject> => {
    const data = crmObject(await crmCall(path))
    validate(data)
    return data
  })
}
export async function crmMutation(path: string, method: string, body: UTSJSONObject): Promise<UTSJSONObject> {
  const owner = crmOwner()
  if (mutationOwner != owner) { mutationKeys.clear(); mutationOwner = owner }
  const memo = path + ':' + method + ':' + JSON.stringify(body)
  const request = mutationKeys.get(memo) ?? crmId()
  mutationKeys.set(memo, request)
  const command = JSON.parse<UTSJSONObject>(JSON.stringify(body))!
  command['requestId'] = request
  const result = await crmCall(path, method, command)
  mutationKeys.delete(memo)
  invalidateCustomerCache()
  return result
}
export type CrmArea = { code: string, name: string, level: string, parent: string }
export function crmDisplayAddress(row: UTSJSONObject): string {
  const names: string[] = []
  for (const field of ['provinceName', 'cityName', 'countyName']) {
    const name = row.getString(field) ?? ''
    if (name.length > 0 && !names.includes(name)) names.push(name)
  }
  let street = (row.getString('address') ?? '').trim()
  for (const name of names) { if (street.startsWith(name)) street = street.substring(name.length).trim() }
  const region = names.join(' · ')
  return region.length == 0 ? street : region + (street.length > 0 ? ' · ' + street : '')
}
export function crmAreaChildren(areas: CrmArea[], level: string, parent: string): CrmArea[] {
  return areas.filter((a: CrmArea): boolean => a.level == level && (parent.length == 0 || a.parent == parent))
}
export async function crmPublicAreas(): Promise<CrmArea[]> {
  const data = readCustomerSnapshot('/crm/stores/context?view=PUBLIC') ?? await crmDisplayRead('/crm/stores/context?view=PUBLIC', (result: UTSJSONObject) => {
    if (!Array.isArray(result['areas'])) throw new Error('服务返回的地区资料不完整，请刷新重试')
  })
  const areas = (data['areas'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]
  return areas.map((a: UTSJSONObject): CrmArea => ({ code: a.getString('code') ?? '', name: a.getString('name') ?? '', level: a.getString('level') ?? '', parent: a.getString('parentCode') ?? '' } as CrmArea))
}
export function crmStore(row: UTSJSONObject): CrmStore {
  return { id: row.getString('id') ?? '', name: row.getString('name') ?? '', address: row.getString('address') ?? '', displayAddress: crmDisplayAddress(row), cooldown: row.getString('cooldownUntil') ?? '', publicPhone: row.getString('publicPhone') ?? '', revision: row.getNumber('revision') ?? 0, ownerEmployeeId: row.getString('ownerEmployeeId') ?? '', ownershipId: row.getString('currentOwnershipId') ?? '', pool: row.getString('poolType') ?? '', phase: row.getString('phase') ?? '', deadline: row.getString('deadlineAt') ?? '', businessStatus: row.getString('businessStatus') ?? '', claimBlocked: row.getString('claimBlockedReason') ?? '', lastVisit: row.getString('lastVisitAt') ?? '', lastOrder: row.getString('lastOrderAt') ?? '', holdReason: row.getString('holdReason') ?? '', longitude: row.getNumber('longitude'), latitude: row.getNumber('latitude'), coordinateSystem: row.getString('coordinateSystem') ?? '', storeType: row.getString('storeTypeCode') } as CrmStore
}
export function crmContact(row: UTSJSONObject): CrmContact {
  const methods = (row['methods'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]
  return { id: row.getString('id') ?? '', name: row.getString('name') ?? '', role: row.getString('role') ?? '', primary: row.getBoolean('primary') ?? false, status: row.getString('status') ?? '', revision: row.getNumber('revision') ?? 0, personRevision: row.getNumber('personRevision') ?? 0, methods: methods.map((m: UTSJSONObject): CrmMethod => ({ id: m.getString('id') ?? '', type: m.getString('type') ?? '', value: m.getString('value') ?? '', status: m.getString('status') ?? '', revision: m.getNumber('revision') ?? 0 } as CrmMethod)) } as CrmContact
}
function crmListPath(view: string, keyword: string, cursor: string, filters: string): string {
  return '/crm/stores?view=' + view + '&size=20&keyword=' + encodeURIComponent(keyword) + (cursor.length > 0 ? '&cursor=' + cursor : '') + filters
}
function crmPage(data: UTSJSONObject): CrmPage {
  const items = (data['items'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]
  return { items: items.map((row: UTSJSONObject): CrmStore => crmStore(row)), total: data.getNumber('total') ?? 0, cursor: data.getString('nextCursor') ?? '' } as CrmPage
}
export function crmListSnapshot(view: string, keyword: string, filters: string = ''): CrmPage | null {
  const data = readCustomerSnapshot(crmListPath(view, keyword, '', filters))
  return data == null ? null : crmPage(data)
}
export async function crmList(view: string, keyword: string, cursor: string = '', filters: string = ''): Promise<CrmPage> {
  return crmPage(await crmDisplayRead(crmListPath(view, keyword, cursor, filters), (data: UTSJSONObject) => { crmValidatePage(data) }))
}
export async function crmDetail(id: string, view: string = 'MINE'): Promise<CrmStore> { return crmStore(crmObject(await crmCall('/crm/stores/' + encodeURIComponent(id) + '?view=' + encodeURIComponent(view)))) }
export async function crmContacts(store: string): Promise<CrmContact[]> {
  const response = await crmCall('/crm/stores/' + encodeURIComponent(store) + '/contacts')
  return ((response['data'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]).map((row: UTSJSONObject): CrmContact => crmContact(row))
}
export async function crmReception(store: string, visit: string): Promise<CrmContact[]> {
  const response = await crmCall('/crm/stores/' + encodeURIComponent(store) + '/visits/' + encodeURIComponent(visit) + '/contacts')
  return ((response['data'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]).map((row: UTSJSONObject): CrmContact => crmContact(row))
}
export function crmSaveReception(store: string, visit: string, ids: string[]): Promise<UTSJSONObject> { return crmMutation('/crm/stores/' + encodeURIComponent(store) + '/visits/' + encodeURIComponent(visit) + '/contacts', 'PUT', { contactIds: ids } as UTSJSONObject) }
export async function crmVisitRecords(store: string): Promise<CrmVisitRecord[]> {
  const response = await crmCall('/crm/stores/' + encodeURIComponent(store) + '/visits?view=MINE')
  return ((response['data'] as UTSJSONObject[] | null) ?? [] as UTSJSONObject[]).map((row: UTSJSONObject): CrmVisitRecord => ({ id: row.getString('id') ?? '', captureId: row.getString('captureRef') ?? '', ownershipId: row.getString('ownershipId') ?? '', salespersonId: row.getString('salespersonId') ?? '', status: row.getString('status') ?? '', visitedAt: row.getString('visitedAt') ?? '', reviewReason: row.getString('reviewReason') ?? '' } as CrmVisitRecord))
}
export function crmVisitStatus(value: string): string {
  if (value == 'IN_PROGRESS') return '拜访进行中'
  if (value == 'SUBMITTED') return '已提交，待核验'
  if (value == 'EFFECTIVE') return '有效拜访'
  if (value == 'INVALID') return '未通过核验'
  if (value == 'VOID') return '已撤销有效认定'
  return '核验状态待刷新'
}
export function crmVisitReason(value: string): string {
  return value.split(',').map((code: string): string => {
    if (code == 'RECORDING_TOO_SHORT') return '录音时长不足'
    if (code == 'RECORDING_UNVERIFIED') return '录音尚未核验'
    if (code == 'AI_PENDING') return 'AI 核验待完成'
    if (code == 'AI_REVIEW_REQUIRED' || code == 'AI_LOW_CONFIDENCE') return '需要人工复核'
    if (code == 'DWELL_TOO_SHORT') return '停留时间不足'
    if (code == 'STOREFRONT_PHOTO_MISSING') return '现场照片不足'
    if (code == 'VISIT_TIME_INVALID') return '到店或离店时间待核实'
    if (code == 'RESULT_MISSING') return '拜访结果未提交'
    if (code == 'CONTACT_NOT_CONFIRMED') return '尚未确认与客户沟通'
    return code
  }).join('；')
}
export function crmPhase(value: string): string { if (value == 'FIRST_VISIT') return '待首访'; if (value == 'FOLLOW_UP') return '持续跟进'; if (value == 'COOPERATING') return '合作维护'; return '公海' }
export function crmTime(value: string): string {
  if (value.trim().length == 0) return '暂无'
  // Android UTS 5.26 throws for an unparseable date instead of returning NaN.
  try {
    const time = Date.parse(value)
    if (!Number.isFinite(time)) return '暂无'
    const d = new Date(time + 8 * 3600000)
    return (d.getUTCMonth() + 1).toString().padStart(2, '0') + '-' + d.getUTCDate().toString().padStart(2, '0') + ' ' + d.getUTCHours().toString().padStart(2, '0') + ':' + d.getUTCMinutes().toString().padStart(2, '0')
  } catch (e) { return '暂无' }
}
export function crmMessage(error: any): string { return error instanceof Error ? error.message : '操作未完成，请刷新重试' }

export async function crmLocation(maximumAccuracy: number | null = null, accuracyTimeoutMs: number = 12000): Promise<UTSJSONObject> {
  const owner = crmOwner()
  const point = await new Promise<DeviceLocation>((resolve, reject) => { requestDeviceLocation(resolve, (message) => reject(new Error(message)), accuracyTimeoutMs) })
  if (owner.length == 0 || owner != crmOwner()) throw new Error('账号已变更，请重新进入作业')
  if (point.accuracy == null || point.accuracy! <= 0) throw new Error('未取得定位精度，请重新定位')
  if (maximumAccuracy != null && point.accuracy! > maximumAccuracy!) throw new Error('定位误差超过 ' + maximumAccuracy!.toString() + ' 米，请重新定位')
  const normalized = crmObject(await crmCall('/sales/work/location/normalize', 'POST', { longitude: point.longitude, latitude: point.latitude, coordinateSystem: point.coordinateSystem } as UTSJSONObject))
  if (normalized.getString('coordinateSystem') != 'GCJ02') throw new Error('坐标转换未完成，请重试定位')
  return { longitude: normalized.getNumber('longitude'), latitude: normalized.getNumber('latitude'), accuracyMeters: point.accuracy, source: 'APP_NATIVE' } as UTSJSONObject
}
export async function crmSalesReady(): Promise<void> {
  await new Promise<UTSJSONObject>((resolve, reject) => { requestSalesApi('/sales/me/context', resolve, (message) => reject(new Error(message))) })
}
export function crmRecentVisitLocation(point: CrmVisitLocation | null, maximumAccuracy: number | null = null): UTSJSONObject | null {
  if (point == null || point.owner.length == 0 || point.owner != crmOwner()) return null
  const now = Date.now(); const location = point.location
  if (!Number.isFinite(point.requestedAt) || !Number.isFinite(point.receivedAt) || point.requestedAt <= 0 || point.receivedAt < point.requestedAt || now < point.receivedAt || now - point.requestedAt > 30000) return null
  const accuracy = location.getNumber('accuracyMeters'); const longitude = location.getNumber('longitude'); const latitude = location.getNumber('latitude')
  if (accuracy == null || !Number.isFinite(accuracy!) || accuracy! <= 0 || (maximumAccuracy != null && accuracy! > maximumAccuracy!)) return null
  if (longitude == null || latitude == null || !Number.isFinite(longitude!) || !Number.isFinite(latitude!) || Math.abs(longitude!) > 180 || Math.abs(latitude!) > 90 || location.getString('source') != 'APP_NATIVE') return null
  return location
}
export async function crmStartVisit(storeId: string, maximumAccuracy: number | null = null, prepared: CrmVisitLocation | null = null, progress: ((stage: string) => void) | null = null, current: (() => boolean) | null = null): Promise<CrmVisit> {
  const owner = crmOwner()
  const check = (): void => { if (owner.length == 0 || owner != crmOwner() || (current != null && !current!())) throw new Error('作业已取消，请重新进入门店') }
  check(); if (progress != null) progress!('核对拜访…')
  const context = await Promise.all<UTSJSONObject>([crmCall('/crm/stores/context?view=MINE'), crmCall('/crm/stores/' + encodeURIComponent(storeId) + '?view=MINE'), crmCall('/crm/stores/' + storeId + '/visits?view=MINE')])
  check()
  const scope = crmObject(context[0]); const store = crmStore(crmObject(context[1]))
  if (store.pool != 'PRIVATE' || store.ownershipId.length == 0 || store.ownerEmployeeId != scope.getString('employeeId')) throw new Error('门店已不属于本人，请刷新归属')
  let partialCapture = false
  const records = context[2]['data'] as UTSJSONObject[] | null
  if (records != null) {
    for (let i = 0; i < records.length; i++) {
      const row = records[i]
      const captureId = row.getString('captureRef') ?? ''
      if (row.getString('ownershipId') == store.ownershipId && captureId.length > 0) {
        try {
          const capture = crmObject(await crmCall('/sales/me/visits/' + encodeURIComponent(captureId)))
          check()
          if (capture.getString('status') == 'CHECKED_IN') {
            const pendingKey = 'rigour.crm.start.v1.' + encodeURIComponent(session.tenantId + ':' + session.userId + ':' + store.ownershipId + ':' + (capture.getString('workDayId') ?? ''))
            uni.removeStorageSync(pendingKey)
            return { visitId: row.getString('id') ?? '', captureId: captureId, storeId: storeId, ownershipId: store.ownershipId } as CrmVisit
          }
        } catch (e) { if (crmMessage(e) != apiErrorMessage('SALES_VISIT_NOT_FOUND', 404)) throw e; partialCapture = true }
        break
      }
    }
  }
  await crmSalesReady()
  check()
  const day = crmObject(await crmCall('/sales/me/work-days/' + crmToday()))
  check()
  if (day.getString('status') != 'ACTIVE') throw new Error('请先完成上班签到，再开始拜访')
  const requestKey = 'rigour.crm.start.v1.' + encodeURIComponent(session.tenantId + ':' + session.userId + ':' + store.ownershipId + ':' + (day.getString('id') ?? ''))
  const savedRequest = uni.getStorageSync(requestKey)
  let command = savedRequest != null && (savedRequest as string).length > 0 ? JSON.parse<UTSJSONObject>(savedRequest as string) : null
  if (command == null && partialCapture) throw new Error('原签到尚未完成采集创建，请从原设备重试或联系管理员核实')
  if (command == null) {
    let location = crmRecentVisitLocation(prepared, maximumAccuracy)
    if (location == null) { if (progress != null) progress!('获取位置…'); location = await crmLocation(maximumAccuracy, 3000) }
    check()
    command = { requestId: crmId(), storeId: storeId, ownershipId: store.ownershipId, workDayId: day.getString('id'), location: location } as UTSJSONObject
    uni.setStorageSync(requestKey, JSON.stringify(command))
  }
  check(); if (progress != null) progress!('正在进入…')
  try {
    const result = crmObject(await crmCall('/sales/work/store-visits', 'POST', command))
    uni.removeStorageSync(requestKey)
    return { visitId: result.getString('visitId') ?? '', captureId: result.getString('captureId') ?? '', storeId: storeId, ownershipId: store.ownershipId } as CrmVisit
  } catch (e) {
    // This specific rejection guarantees CRM created no visit; the next attempt needs a fresh fix.
    if (crmMessage(e) == apiErrorMessage('CRM_STORE_VISIT_OUTSIDE_RADIUS', 409) || crmMessage(e) == apiErrorMessage('LOCATION_ACCURACY_INSUFFICIENT', 409)) uni.removeStorageSync(requestKey)
    throw e
  }
}
