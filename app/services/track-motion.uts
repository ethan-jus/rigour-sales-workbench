export const motionUnknown = -1
export const motionStill = 0
export const motionMoving = 1

export type RouteFix = {
  id: string, latitude: number, longitude: number, accuracy: number, time: number, source: string, motion: number
}

export function routeGapMillis(intervalSeconds: number): number {
  return Math.max(20, Math.min(300, intervalSeconds * 3)) * 1000
}

export function routeDistance(latA: number, lngA: number, latB: number, lngB: number): number {
  const rad = Math.PI / 180
  const y = Math.sin((latB - latA) * rad / 2)
  const x = Math.sin((lngB - lngA) * rad / 2)
  const chord = y * y + Math.cos(latA * rad) * Math.cos(latB * rad) * x * x
  return 12742000 * Math.asin(Math.min(1, Math.sqrt(chord)))
}

function separation(a: RouteFix, b: RouteFix): number {
  return routeDistance(a.latitude, a.longitude, b.latitude, b.longitude)
}

export class TrackMotion {
  private seeds: RouteFix[] = []
  private last: RouteFix | null = null
  private vertex: RouteFix | null = null
  private pending: RouteFix | null = null

  reset(): void {
    this.seeds = []
    this.last = null
    this.vertex = null
    this.pending = null
  }

  push(fix: RouteFix, intervalSeconds: number): string[] {
    const gap = routeGapMillis(intervalSeconds)
    if ((fix.source != 'APP_GPS' && fix.source != 'APP_GPS_STILL') || fix.accuracy > 25) {
      this.reset()
      return [] as string[]
    }
    const last = this.last
    if (last != null) {
      const elapsed = fix.time - last.time
      if (elapsed <= 0 || elapsed > gap || separation(last, fix) * 1000 > elapsed * 55) this.reset()
    }

    if (fix.source == 'APP_GPS_STILL' || fix.motion == motionStill) {
      // The next stationary fix can verify the final moving sample before the stop.
      const from = this.vertex
      const end = this.pending
      const finalEdge = from != null && end != null && end.motion == motionMoving
        && separation(from, end) >= 1.5 && !this.spike(from, end, fix)
      this.reset()
      return finalEdge ? [from!.id, end!.id] : [] as string[]
    }
    this.last = fix
    const from = this.vertex
    if (from == null) return this.confirmStart(fix, intervalSeconds)
    if (fix.time - from.time > gap) {
      const pending = this.pending
      this.reset()
      this.last = fix
      if (pending != null && fix.time - pending.time <= gap) this.seeds.push(pending)
      return this.confirmStart(fix, intervalSeconds)
    }

    const middle = this.pending
    this.pending = fix
    if (middle == null) return [] as string[]
    const step = separation(from, middle)
    if (step < 1.5 || this.spike(from, middle, fix)) return [] as string[]
    if (middle.motion != motionMoving && fix.motion != motionMoving) {
      const displacement = separation(from, fix)
      const localError = Math.max(3, Math.min(10, Math.max(from.accuracy, fix.accuracy) * 0.8))
      const following = separation(middle, fix)
      const speed = step / (middle.time - from.time)
      const nextSpeed = following / (fix.time - middle.time)
      if (displacement < localError || step + following > displacement * 1.7
          || Math.max(speed, nextSpeed) > Math.min(speed, nextSpeed) * 2.3) return [] as string[]
    }
    this.vertex = middle
    return [from.id, middle.id]
  }

  private spike(from: RouteFix, middle: RouteFix, next: RouteFix): boolean {
    const a = separation(from, middle)
    const b = separation(middle, next)
    // A corroborated local U-turn can double back on the same path.
    const supported = middle.motion == motionMoving && (from.motion == motionMoving || next.motion == motionMoving)
    const scale = Math.max(from.accuracy, middle.accuracy, next.accuracy)
    return a + b > Math.max(8, 2.8 * separation(from, next)) && Math.min(a, b) > (supported ? scale * 1.8 : 3)
  }

  private confirmStart(fix: RouteFix, intervalSeconds: number): string[] {
    this.seeds.push(fix)
    if (this.seeds.length > 8) this.seeds.shift()
    for (let start = 0; start <= this.seeds.length - 3; start++) {
      const first = this.seeds[start]
      const displacement = separation(first, fix)
      const moving = this.seeds.slice(start).filter((point: RouteFix): boolean => point.motion == motionMoving)
      const supported = moving.length >= 2
      if (supported && moving[0].time - first.time > intervalSeconds * 1000 + 1500) continue
      const accuracy = Math.max(first.accuracy, fix.accuracy)
      if (!supported && this.seeds.length - start < (accuracy <= 7 ? 4 : 5)) continue
      if (displacement < (supported ? 12 : Math.max(12, first.accuracy + fix.accuracy))) continue
      let distance = 0
      let nearestSpeed = Number.POSITIVE_INFINITY
      let highestSpeed = 0
      let progress = 0
      let reversing = false
      const candidate = [first] as RouteFix[]
      for (let index = start + 1; index < this.seeds.length; index++) {
        const p = this.seeds[index]
        const previous = candidate[candidate.length - 1]
        const step = separation(previous, p)
        if (step < 1.5) continue
        distance += step
        const speed = step / (p.time - previous.time)
        nearestSpeed = Math.min(nearestSpeed, speed)
        highestSpeed = Math.max(highestSpeed, speed)
        const net = separation(first, p)
        if (net + 1.5 < progress) reversing = true
        progress = net
        candidate.push(p)
      }
      if (candidate.length < (supported ? 3 : 4) || progress < 12 || distance > displacement * 1.85
          || (!supported && (reversing || highestSpeed > nearestSpeed * 2.3))) continue
      this.vertex = candidate[candidate.length - 1]
      this.seeds = []
      return candidate.map((point: RouteFix): string => point.id)
    }
    return [] as string[]
  }
}
