import { appEnvironment, environmentReady, serviceOrigin } from './config.uts'
import { session, clearSession } from './session.uts'

// #ifdef APP-ANDROID
import SecureRandom from 'java.security.SecureRandom'
import MessageDigest from 'java.security.MessageDigest'
import Base64 from 'android.util.Base64'
import Intent from 'android.content.Intent'
import Uri from 'android.net.Uri'
import Charsets from 'kotlin.text.Charsets'
// #endif

type LoginAttempt = {
  state: string,
  verifier: string,
  tokenEndpoint: string,
  expiresAt: number,
  exchanging: boolean,
  generation: number
}

let attempt: LoginAttempt | null = null
let generation = 0
let loadingDiscovery = false
let loginSuccess: (() => void) | null = null
let loginFailure: ((message: string) => void) | null = null
let expirationTimer: number | null = null

function clearAttempt(): void {
  attempt = null
  loadingDiscovery = false
  if (expirationTimer != null) clearTimeout(expirationTimer!)
  expirationTimer = null
}

function failLogin(message: string): void {
  const callback = loginFailure
  generation += 1
  clearAttempt()
  loginSuccess = null
  loginFailure = null
  if (callback != null) callback(message)
  else uni.showToast({ title: message, icon: 'none' })
}

// The native verifier and state never use Math.random or ordinary uni storage.
function prepareAndroidLogin(tokenEndpoint: string): LoginAttempt | null {
  // #ifdef APP-ANDROID
  const random = new SecureRandom()
  const flags = Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING
  const verifier = Base64.encodeToString(random.generateSeed(32), flags)
  const state = Base64.encodeToString(random.generateSeed(32), flags)
  return { state, verifier, tokenEndpoint, expiresAt: Date.now() + 300000, exchanging: false, generation }
  // #endif
  // #ifndef APP-ANDROID
  return null
  // #endif
}

function launchAuthorization(authorizationEndpoint: string, current: LoginAttempt): void {
  // #ifdef APP-ANDROID
  try {
    const digest = MessageDigest.getInstance('SHA-256').digest(current.verifier.toByteArray(Charsets.US_ASCII))
    const challenge = Base64.encodeToString(digest, Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING)
    const url = authorizationEndpoint + '?response_type=code&client_id=' + encodeURIComponent(appEnvironment.clientId)
      + '&redirect_uri=' + encodeURIComponent(appEnvironment.redirectUri)
      + '&scope=profile&state=' + encodeURIComponent(current.state)
      + '&code_challenge_method=S256&code_challenge=' + encodeURIComponent(challenge)
    const activity = UTSAndroid.getUniActivity()
    if (activity == null) { failLogin('当前无法打开公司登录，请返回页面重试。'); return }
    activity.startActivity(new Intent(Intent.ACTION_VIEW, Uri.parse(url)))
  } catch (_) {
    failLogin('无法打开系统浏览器，请确认手机已安装浏览器后重试。')
  }
  // #endif
}

export function beginCompanyLogin(success: () => void, fail: (message: string) => void): void {
  if (!environmentReady()) { fail('公司登录服务尚未配置，暂不能登录。'); return }
  // #ifndef APP-ANDROID
  fail('此系统的公司登录仍在接入中，请先使用 Android 内部测试版。')
  return
  // #endif
  if (loadingDiscovery || attempt != null) { fail('正在等待公司登录，请完成浏览器中的登录或稍后重试。'); return }
  generation += 1
  const thisGeneration = generation
  loginSuccess = success
  loginFailure = fail
  loadingDiscovery = true
  expirationTimer = setTimeout(() => {
    if (generation == thisGeneration) failLogin('登录已超时，请重新登录。')
  }, 300000)
  const issuer = appEnvironment.issuer.endsWith('/') ? appEnvironment.issuer.slice(0, -1) : appEnvironment.issuer
  uni.request<UTSJSONObject>({
    url: issuer + '/.well-known/openid-configuration', method: 'GET', timeout: 20000,
    success: (response) => {
      if (generation != thisGeneration) return
      const metadata = response.data
      if (response.statusCode != 200 || metadata == null) { failLogin('无法读取公司登录配置，请稍后重试。'); return }
      const metadataIssuer = metadata.getString('issuer') ?? ''
      const authorizationEndpoint = metadata.getString('authorization_endpoint') ?? ''
      const tokenEndpoint = metadata.getString('token_endpoint') ?? ''
      if (metadataIssuer != appEnvironment.issuer
        || serviceOrigin(authorizationEndpoint) != serviceOrigin(appEnvironment.issuer)
        || serviceOrigin(tokenEndpoint) != serviceOrigin(appEnvironment.issuer)
        || authorizationEndpoint.includes('?') || authorizationEndpoint.includes('#')
        || tokenEndpoint.includes('?') || tokenEndpoint.includes('#')) {
        failLogin('公司登录地址校验未通过，请联系管理员。')
        return
      }
      try {
        const current = prepareAndroidLogin(tokenEndpoint)
        if (current == null) { failLogin('当前系统尚未支持安全登录。'); return }
        loadingDiscovery = false
        attempt = current
        launchAuthorization(authorizationEndpoint, current)
      } catch (_) {
        failLogin('无法创建安全登录请求，请重试。')
      }
    },
    fail: (_) => { if (generation == thisGeneration) failLogin('无法连接公司登录服务，请检查网络。') }
  })
}

type CallbackValues = { valid: boolean, state: string, code: string, error: string }

function callbackValues(query: string): CallbackValues {
  const values: CallbackValues = { valid: true, state: '', code: '', error: '' }
  const keys: string[] = []
  try {
    query.split('&').forEach((part: string) => {
      const at = part.indexOf('=')
      if (at < 1) { values.valid = false; return }
      const key = decodeURIComponent(part.substring(0, at))
      const value = decodeURIComponent(part.substring(at + 1).replace(/\+/g, ' '))
      if (key == null || value == null) { values.valid = false; return }
      if (keys.includes(key)) { values.valid = false; return }
      keys.push(key)
      if (key == 'state') values.state = value
      if (key == 'code') values.code = value
      if (key == 'error') values.error = value
      if (key == 'access_token' || key == 'id_token') values.valid = false
    })
  } catch (_) { values.valid = false }
  return values
}

function verifyCurrentUser(accessToken: string, expiresIn: number, thisGeneration: number): void {
  uni.request<UTSJSONObject>({
    url: appEnvironment.gatewayOrigin + '/api/v1/me', method: 'GET', timeout: 20000,
    header: { 'Authorization': 'Bearer ' + accessToken, 'Accept-Language': 'zh-CN' },
    success: (response) => {
      if (generation != thisGeneration) return
      const body = response.data
      if (response.statusCode != 200 || body == null) { failLogin('公司账号校验失败，请重新登录。'); return }
      const profile = body.getJSON('data') ?? body
      const userId = profile.getString('id') ?? ''
      const tenantId = profile.getString('tenantId') ?? ''
      if (profile.getString('principalScope') != 'TENANT' || userId.length == 0 || tenantId.length == 0) {
        failLogin('请使用公司员工账号登录销售工作台。')
        return
      }
      clearSession()
      session.userId = userId
      session.tenantId = tenantId
      session.username = profile.getString('username') ?? ''
      session.displayName = profile.getString('displayName') ?? session.username
      session.permissions = profile.getArray<string>('permissions') ?? [] as string[]
      session.accessToken = accessToken
      session.expiresAt = Date.now() + (expiresIn - 30) * 1000
      session.authenticated = true
      const callback = loginSuccess
      clearAttempt()
      loginSuccess = null
      loginFailure = null
      if (callback != null) callback()
    },
    fail: (_) => { if (generation == thisGeneration) failLogin('无法校验公司账号，请检查网络后重新登录。') }
  })
}

export function handleAuthCallback(url: string): void {
  const question = url.indexOf('?')
  if (question < 0 || url.substring(0, question) != appEnvironment.redirectUri) return
  const current = attempt
  if (current == null) { failLogin('登录会话已失效，请重新发起公司登录。'); return }
  if (current.exchanging) return
  if (Date.now() > current.expiresAt || url.includes('#')) { failLogin('登录回调已失效，请重新登录。'); return }
  const values = callbackValues(url.substring(question + 1))
  if (!values.valid || values.state.length == 0 || values.state != current.state) { failLogin('登录安全校验失败，请重新登录。'); return }
  if (values.error.length > 0) { failLogin('公司登录未完成，请重新登录。'); return }
  if (values.code.length == 0) { failLogin('公司登录未返回授权结果，请重试。'); return }
  current.exchanging = true
  const thisGeneration = current.generation
  uni.request<UTSJSONObject>({
    url: current.tokenEndpoint, method: 'POST', timeout: 20000,
    header: { 'Content-Type': 'application/x-www-form-urlencoded' },
    data: 'grant_type=authorization_code&client_id=' + encodeURIComponent(appEnvironment.clientId)
      + '&redirect_uri=' + encodeURIComponent(appEnvironment.redirectUri)
      + '&code=' + encodeURIComponent(values.code) + '&code_verifier=' + encodeURIComponent(current.verifier),
    success: (response) => {
      if (generation != thisGeneration) return
      const body = response.data
      if (response.statusCode != 200 || body == null) { failLogin('公司登录授权已失效，请重新登录。'); return }
      const accessToken = body.getString('access_token') ?? ''
      const expiresIn = body.getNumber('expires_in') ?? 0
      if (accessToken.length == 0 || body.getString('token_type')?.toLowerCase() != 'bearer' || expiresIn <= 30) {
        failLogin('公司登录授权信息不完整，请联系管理员。')
        return
      }
      // profile-only OAuth: identity always comes from the verified /me response.
      // ID tokens and refresh tokens are neither used nor stored in this slice.
      verifyCurrentUser(accessToken, expiresIn, thisGeneration)
    },
    fail: (_) => { if (generation == thisGeneration) failLogin('登录授权交换失败，请检查网络后重新登录。') }
  })
}

export function logoutCompany(): void {
  generation += 1
  clearAttempt()
  loginSuccess = null
  loginFailure = null
  clearSession()
}
