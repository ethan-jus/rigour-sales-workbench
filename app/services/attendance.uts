import { reactive } from 'vue'
import { crmCall, crmObject, crmOwner, crmToday, crmId, crmLocation, crmSalesReady, crmMessage } from './crm.uts'
import { apiErrorMessage } from './api.uts'
import { session, hasPermission } from './session.uts'
import { fieldStorageScope, readFieldValue, writeFieldValue, clearFieldValue, fieldStorageDurable } from './field-storage.uts'

export type WorkPeriod = { startedAt: string, endedAt: string, reason: string }
export type WorkDay = { id: string, date: string, status: string, checkedInAt: string, checkedOutAt: string, sessionId: string, confirmedTrack: boolean, pointCount: number, interruptionCount: number, workMinutes: number, periods: WorkPeriod[], adjustmentAllowed: boolean }
type AttendanceState = { businessDate: string, captureUntil: number, serverOffset: number, locationEnabled: boolean, allowResume: boolean, pendingResumeReason: string, sampleIntervalSeconds: number, uploadIntervalSeconds: number, maximumAccuracyMeters: number | null, offlineDeadline: number, busy: boolean, phase: string, day: WorkDay | null, pending: boolean, error: string, revision: number }
export const attendance = reactive({ businessDate: '', captureUntil: 0, serverOffset: 0, locationEnabled: false, allowResume: false, pendingResumeReason: '', sampleIntervalSeconds: 0, uploadIntervalSeconds: 0, maximumAccuracyMeters: null, offlineDeadline: 0, busy: false, phase: '', day: null, pending: false, error: '', revision: 0 } as AttendanceState)
let readOwner = ''
let readAt = 0
let readPromise: Promise<WorkDay | null> | null = null
let actionOwner = ''
let generation = 0
function assertOwner(owner: string): void { if (owner.length == 0 || owner != crmOwner()) throw new Error('账号已变更，请重新进入作业') }
function parseDay(data: UTSJSONObject): WorkDay {
  const id = data.getString('id') ?? ''; const status = data.getString('status') ?? ''
  if (id.length == 0 || !['ACTIVE', 'FINISHED', 'MISSING_CHECK_OUT'].includes(status)) throw new Error('签到状态不完整，请刷新')
  const periods = data.getArray<UTSJSONObject>('workPeriods')
  if (periods == null || data.getNumber('totalWorkMinutes') == null) throw new Error('作业时段不完整，请刷新')
  return { id, adjustmentAllowed: data.getBoolean('adjustmentAllowed') == true, date: data.getString('businessDate') ?? '', status, checkedInAt: data.getString('checkedInAt') ?? '', checkedOutAt: data.getString('checkedOutAt') ?? '', sessionId: data.getString('locationSessionId') ?? '', confirmedTrack: data.getBoolean('confirmedTrack') == true, pointCount: data.getNumber('locationPointCount') ?? 0, interruptionCount: data.getNumber('interruptionCount') ?? 0, workMinutes: data.getNumber('totalWorkMinutes')!, periods: periods!.map((row: UTSJSONObject): WorkPeriod => ({ startedAt: row.getString('startedAt') ?? '', endedAt: row.getString('endedAt') ?? '', reason: row.getString('reason') ?? '' } as WorkPeriod)) } as WorkDay
}
export function attendanceClock(value: string): string {
  if (value.length == 0) return '—'
  const time = Date.parse(value)
  if (!Number.isFinite(time)) return '—'
  const d = new Date(time + 8 * 3600000)
  return d.getUTCHours().toString().padStart(2, '0') + ':' + d.getUTCMinutes().toString().padStart(2, '0')
}
export function resetAttendance(): void {
  generation++; readOwner = ''; readAt = 0; readPromise = null
  attendance.businessDate = ''; attendance.captureUntil = 0; attendance.locationEnabled = false; attendance.allowResume = false; attendance.pendingResumeReason = ''
  attendance.day = null; attendance.pending = false; attendance.error = ''; attendance.phase = ''
  // An in-flight mutation keeps its lock until its own finally, even on logout.
}
export async function readWorkDay(date: string = crmToday()): Promise<WorkDay | null> {
  try { return parseDay(crmObject(await crmCall('/sales/me/work-days/' + date))) }
  catch (e) { if (crmMessage(e) == apiErrorMessage('SALES_WORK_DAY_NOT_FOUND', 404)) return null; throw e }
}
export function refreshAttendance(force: boolean = false): Promise<WorkDay | null> {
  const owner = crmOwner()
  if (readOwner != owner) { resetAttendance(); readOwner = owner }
  if (readPromise != null) return readPromise!
  const now = Date.now()
  if (!force && readAt > 0 && now - readAt < 15000 && now + attendance.serverOffset < attendance.captureUntil) return Promise.resolve(attendance.day)
  const identity = crmOwner(); const version = generation
  const pending = crmCall('/sales/me/attendance-context').then(async (response: UTSJSONObject): Promise<WorkDay | null> => {
    assertOwner(identity)
    if (version != generation) throw new Error('签到状态已更新，请重试')
    const data = crmObject(response)
    const date = data.getString('businessDate') ?? ''
    const until = Date.parse(data.getString('captureUntil') ?? '')
    const serverTime = Date.parse(data.getString('serverTime') ?? '')
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || !Number.isFinite(until) || !Number.isFinite(serverTime)) throw new Error('作业日期不完整，请刷新')
    const raw = data.getJSON('workDay'); const day = raw == null ? null : parseDay(raw!)
    const sampleInterval = data.getNumber('locationSampleIntervalSeconds')
    const uploadInterval = data.getNumber('locationUploadIntervalSeconds')
    if (sampleInterval == null || uploadInterval == null || sampleInterval! <= 0 || uploadInterval! <= 0) throw new Error('轨迹采样与上传规则不完整，请刷新')
    if (day != null && day!.date != date) throw new Error('作业日期不一致，请刷新')
    const scope = fieldStorageScope()
    const pendingIn = await readFieldValue(scope, 'punch:' + date + ':in')
    const pendingOut = await readFieldValue(scope, 'punch:' + date + ':out')
    const pendingResume = await readFieldValue(scope, 'punch:' + date + ':resume')
    const signInPending = pendingIn != null && day == null
    const resumePending = pendingResume != null && day?.status == 'FINISHED' && day!.sessionId == (pendingResume!.getString('priorSessionId') ?? '')
    const signOutPending = pendingOut != null && day?.status == 'ACTIVE' && day!.sessionId == (pendingOut!.getString('priorSessionId') ?? '')
    // A command from an earlier segment cannot be replayed against a reopened segment.
    try {
      if (pendingIn != null && !signInPending) await clearFieldValue(scope, 'punch:' + date + ':in')
      if (pendingResume != null && !resumePending) await clearFieldValue(scope, 'punch:' + date + ':resume')
      if (pendingOut != null && !signOutPending) await clearFieldValue(scope, 'punch:' + date + ':out')
    } catch (_) {}
    assertOwner(identity)
    if (readOwner == owner && version == generation) {
      attendance.day = day; attendance.businessDate = date; attendance.captureUntil = until
      attendance.serverOffset = serverTime - Date.now(); attendance.locationEnabled = data.getBoolean('locationEnabled') ?? false; attendance.allowResume = data.getBoolean('allowResume') == true
      attendance.sampleIntervalSeconds = sampleInterval!
      attendance.uploadIntervalSeconds = uploadInterval!
      attendance.maximumAccuracyMeters = data.getNumber('minimumLocationAccuracyMeters')
      attendance.offlineDeadline = Math.max(0, data.getNumber('offlineUploadDeadlineMinutes') ?? 0)
      attendance.pending = signInPending || signOutPending || resumePending
      attendance.pendingResumeReason = resumePending ? pendingResume!.getJSON('command')?.getString('reason') ?? '' : ''
      readAt = Date.now()
    }
    return day
  }).finally(() => { if (readOwner == owner && version == generation) readPromise = null })
  readPromise = pending
  return pending
}
function installInstanceId(): string {
  // An install identifier is correlation evidence, not verified device attestation.
  const key = 'rigour.field.install.v1'; const raw = uni.getStorageSync(key)
  if (typeof raw == 'string' && (raw as string).length > 0) return raw as string
  const id = 'app-' + crmId(); uni.setStorageSync(key, id); return id
}
async function performAttendance(checkOut: boolean, resumeReason: string | null): Promise<WorkDay> {
  const resuming = resumeReason != null
  if (resuming && (resumeReason!.trim().length == 0 || resumeReason!.trim().length > 500)) throw new Error('请填写恢复作业原因（最多500字）')
  if (!hasPermission('sales:work-day:write')) throw new Error('当前账号无打卡权限')
  if (attendance.busy) throw new Error('正在处理打卡，请稍候')
  const owner = crmOwner(); const scope = fieldStorageScope()
  actionOwner = owner; attendance.busy = true; attendance.error = ''; attendance.phase = '确认状态…'
  try {
    await crmSalesReady(); assertOwner(owner)
    const day = await refreshAttendance(true); assertOwner(owner)
    const key = 'punch:' + attendance.businessDate + ':' + (resuming ? 'resume' : checkOut ? 'out' : 'in')
    let saved = await readFieldValue(scope, key); assertOwner(owner)
    if ((!checkOut && day?.status == 'ACTIVE') || (checkOut && day?.status == 'FINISHED')) {
      if (saved != null) await clearFieldValue(scope, key)
      attendance.pending = false; return day!
    }
    if (!checkOut && !resuming && day != null) throw new Error('当天已签退，请在拜访页面填写原因后恢复作业')
    if (resuming && (day?.status != 'FINISHED' || !attendance.allowResume)) throw new Error('当前状态或规则不允许恢复作业')
    if (checkOut && day == null) throw new Error('当天尚未签到')
    if (resuming && saved != null && saved!.getJSON('command')?.getString('reason') != resumeReason!.trim()) throw new Error('上次恢复请求尚待同步，请按原原因重试')
    if (saved == null) {
      attendance.phase = '定位中…'
      const location = await crmLocation(null, 5000); assertOwner(owner)
      const command = { idempotencyKey: crmId(), clientOccurredAt: new Date().toISOString(), location } as UTSJSONObject
      if (!checkOut) command['clientInstanceId'] = installInstanceId()
      // #ifdef APP-ANDROID
      if (!checkOut) command['confirmedTrack'] = true
      // #endif
      if (resuming) command['reason'] = resumeReason!.trim()
      saved = { priorSessionId: day?.sessionId ?? '', path: resuming ? '/sales/work-days/' + day!.id + '/resume' : checkOut ? '/sales/work-days/' + day!.id + '/check-out' : '/sales/work-days/check-in', command } as UTSJSONObject
      await writeFieldValue(scope, key, saved!); assertOwner(owner)
    }
    attendance.phase = '提交中…'; attendance.pending = true
    const result = parseDay(crmObject(await crmCall(saved!.getString('path')!, 'POST', saved!.getJSON('command'))))
    assertOwner(owner)
    // A confirmed mutation supersedes any context read started before its receipt.
    generation++; readPromise = null
    // Commit the server receipt before cleaning the local retry envelope.
    attendance.day = result; readAt = Date.now(); attendance.pending = false; attendance.revision++; attendance.pendingResumeReason = ''
    try { await clearFieldValue(scope, key) } catch (_) { attendance.error = '打卡已完成，本机同步记录待清理' }
    return result
  } catch (e) {
    if (owner == crmOwner()) {
      attendance.error = crmMessage(e)
      if (attendance.pending && !fieldStorageDurable()) attendance.error += '；请保持 App 打开后重试'
    }
    throw e
  } finally {
    if (actionOwner == owner) { attendance.busy = false; attendance.phase = ''; actionOwner = '' }
  }
}
export async function attendanceStatus(): Promise<string> { const day = await refreshAttendance(true); return day == null ? 'NOT_STARTED' : day.status }

export async function punchAttendance(checkOut: boolean): Promise<WorkDay> { return await performAttendance(checkOut, null) }
export async function resumeAttendance(reason: string): Promise<WorkDay> { return await performAttendance(false, reason) }
export function workDurationLabel(day: WorkDay | null): string {
  if (day == null) return '—'
  const now = Date.now() + attendance.serverOffset
  let minutes = day!.workMinutes
  if (day!.status == 'ACTIVE') {
    let milliseconds = 0
    for (const period of day!.periods) { const end = period.endedAt.length > 0 ? Date.parse(period.endedAt) : now; milliseconds += Math.max(0, end - Date.parse(period.startedAt)) }
    minutes = Math.floor(milliseconds / 60000)
  }
  return Math.floor(minutes / 60).toString() + '小时' + (minutes % 60).toString() + '分'
}
export async function checkInAttendance(): Promise<void> { await punchAttendance(false) }
