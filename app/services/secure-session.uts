import { appEnvironment } from './config.uts'

// #ifdef APP-ANDROID
import Build from 'android.os.Build'
import AtomicFile from 'android.util.AtomicFile'
import Base64 from 'android.util.Base64'
import KeyGenParameterSpec from 'android.security.keystore.KeyGenParameterSpec'
import KeyProperties from 'android.security.keystore.KeyProperties'
import File from 'java.io.File'
import FileOutputStream from 'java.io.FileOutputStream'
import KeyStore from 'java.security.KeyStore'
import MessageDigest from 'java.security.MessageDigest'
import Executors from 'java.util.concurrent.Executors'
import Runnable from 'java.lang.Runnable'
import Cipher from 'javax.crypto.Cipher'
import KeyGenerator from 'javax.crypto.KeyGenerator'
import SecretKey from 'javax.crypto.SecretKey'
import GCMParameterSpec from 'javax.crypto.spec.GCMParameterSpec'
import Charsets from 'kotlin.text.Charsets'
// #endif

export type StoredSession = {
  refreshToken: string,
  issuer: string,
  clientId: string,
  userId: string,
  tenantId: string
}

const unsupportedMessage = '当前系统尚未支持安全保存登录，请重新登录。'

// #ifdef APP-ANDROID
class SecureSessionTask implements Runnable {
  action: () => void
  constructor(action: () => void) { this.action = action }
  override run(): void { this.action() }
}

// Preserve submission order: a logout clear must follow every earlier write.
const secureSessionExecutor = Executors.newSingleThreadExecutor()

function onMain(action: () => void): void {
  UTSAndroid.getDispatcher('main').async((_: any | null) => { action() }, null)
}

function namespace(): string {
  return 'com.rigour.workbench|__UNI__EE5460C|' + appEnvironment.environment
    + '|' + appEnvironment.issuer + '|' + appEnvironment.clientId
}

function storageId(scope: string): string {
  const digest = MessageDigest.getInstance('SHA-256').digest(scope.toByteArray(Charsets.UTF_8))
  return 'rigour-sales-session-' + Base64.encodeToString(digest, Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING)
}

function sessionFile(id: string): AtomicFile {
  const context = UTSAndroid.getAppContext()
  if (context == null) throw new Error('secure storage unavailable')
  return new AtomicFile(new File(context.getNoBackupFilesDir(), id + '.enc'))
}

function loadKeyStore(): KeyStore {
  const store = KeyStore.getInstance('AndroidKeyStore')
  store.load(null, null)
  return store
}

function encryptionKey(id: string, create: boolean): SecretKey {
  const store = loadKeyStore()
  if (store.containsAlias(id)) return store.getKey(id, null) as SecretKey
  if (!create) throw new Error('secure key unavailable')
  const generator = KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, 'AndroidKeyStore')
  const spec = new KeyGenParameterSpec.Builder(id, KeyProperties.PURPOSE_ENCRYPT | KeyProperties.PURPOSE_DECRYPT)
    .setKeySize(256)
    .setBlockModes(KeyProperties.BLOCK_MODE_GCM)
    .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
    .setRandomizedEncryptionRequired(true)
    .build()
  generator.init(spec)
  return generator.generateKey()
}

function hasSessionFile(file: AtomicFile): boolean {
  const base = file.getBaseFile()
  return base.exists() || new File(base.getPath() + '.bak').exists()
}

function validSession(value: StoredSession, issuer: string, clientId: string): boolean {
  return value.refreshToken.length > 0 && value.issuer == issuer && value.clientId == clientId
    && value.userId.length > 0 && value.tenantId.length > 0
}
// #endif

export function secureSessionSupported(): boolean {
  // #ifdef APP-ANDROID
  return Build.VERSION.SDK_INT >= 23 && UTSAndroid.getAppContext() != null
  // #endif
  // #ifndef APP-ANDROID
  return false
  // #endif
}

export function readSecureSession(success: (value: StoredSession | null) => void, fail: (message: string) => void): void {
  if (!secureSessionSupported()) { setTimeout(() => { fail(unsupportedMessage) }, 0); return }
  // #ifdef APP-ANDROID
  const scope = namespace()
  const issuer = appEnvironment.issuer
  const clientId = appEnvironment.clientId
  secureSessionExecutor.execute(new SecureSessionTask(() => {
    let value: StoredSession | null = null
    try {
      const id = storageId(scope)
      const file = sessionFile(id)
      if (hasSessionFile(file)) {
        const envelope = file.readFully().toString(Charsets.UTF_8).split('\n')
        if (envelope.length != 3 || envelope[0] != 'v1') throw new Error('invalid secure envelope')
        const iv = Base64.decode(envelope[1], Base64.NO_WRAP)
        if (iv.size != 12) throw new Error('invalid secure iv')
        const cipher = Cipher.getInstance('AES/GCM/NoPadding')
        cipher.init(Cipher.DECRYPT_MODE, encryptionKey(id, false), new GCMParameterSpec(128, iv))
        cipher.updateAAD(('v1|' + scope).toByteArray(Charsets.UTF_8))
        const plaintext = cipher.doFinal(Base64.decode(envelope[2], Base64.NO_WRAP)).toString(Charsets.UTF_8)
        const body = JSON.parseObject(plaintext)
        if (body == null) throw new Error('invalid secure payload')
        const restored: StoredSession = {
          refreshToken: body.getString('refreshToken') ?? '', issuer: body.getString('issuer') ?? '',
          clientId: body.getString('clientId') ?? '', userId: body.getString('userId') ?? '',
          tenantId: body.getString('tenantId') ?? ''
        }
        if (!validSession(restored, issuer, clientId)) throw new Error('invalid secure identity')
        value = restored
      }
    } catch (_) {
      onMain(() => { fail('已保存的登录信息无法通过安全校验，请重新登录。') })
      return
    }
    onMain(() => { success(value) })
  }))
  // #endif
}

export function writeSecureSession(value: StoredSession, success: () => void, fail: (message: string) => void): void {
  if (!secureSessionSupported()) { setTimeout(() => { fail(unsupportedMessage) }, 0); return }
  // #ifdef APP-ANDROID
  const scope = namespace()
  const issuer = appEnvironment.issuer
  const clientId = appEnvironment.clientId
  const snapshot: StoredSession = {
    refreshToken: value.refreshToken, issuer: value.issuer, clientId: value.clientId,
    userId: value.userId, tenantId: value.tenantId
  }
  secureSessionExecutor.execute(new SecureSessionTask(() => {
    let file: AtomicFile | null = null
    let output: FileOutputStream | null = null
    try {
      if (!validSession(snapshot, issuer, clientId)) throw new Error('invalid secure identity')
      const id = storageId(scope)
      const cipher = Cipher.getInstance('AES/GCM/NoPadding')
      cipher.init(Cipher.ENCRYPT_MODE, encryptionKey(id, true))
      cipher.updateAAD(('v1|' + scope).toByteArray(Charsets.UTF_8))
      const encrypted = cipher.doFinal(JSON.stringify(snapshot).toByteArray(Charsets.UTF_8))
      const envelope = 'v1\n' + Base64.encodeToString(cipher.getIV(), Base64.NO_WRAP)
        + '\n' + Base64.encodeToString(encrypted, Base64.NO_WRAP)
      file = sessionFile(id)
      output = file!.startWrite()
      output!.write(envelope.toByteArray(Charsets.UTF_8))
      file!.finishWrite(output)
      output = null
      if (file!.readFully().toString(Charsets.UTF_8) != envelope) throw new Error('secure write incomplete')
    } catch (_) {
      if (file != null && output != null) {
        try { file!.failWrite(output) } catch (_) {}
      }
      onMain(() => { fail('无法安全保存登录信息，请重新登录。') })
      return
    }
    onMain(success)
  }))
  // #endif
}

export function clearSecureSession(success: () => void, fail: (message: string) => void): void {
  if (!secureSessionSupported()) { setTimeout(() => { fail(unsupportedMessage) }, 0); return }
  // #ifdef APP-ANDROID
  const scope = namespace()
  secureSessionExecutor.execute(new SecureSessionTask(() => {
    let cleared = true
    try {
      const id = storageId(scope)
      // Attempt both erasure steps even if one fails. Never report partial erasure as success.
      try { loadKeyStore().deleteEntry(id) } catch (_) { cleared = false }
      try {
        const file = sessionFile(id)
        file.delete()
        if (hasSessionFile(file) || new File(file.getBaseFile().getPath() + '.new').exists()) cleared = false
      } catch (_) { cleared = false }
    } catch (_) { cleared = false }
    onMain(() => {
      if (cleared) success()
      else fail('无法完全清除已保存的登录信息，请重试退出登录。')
    })
  }))
  // #endif
}
