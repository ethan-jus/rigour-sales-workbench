import { appEnvironment } from './config.uts'
import { secureStorageSupported, readSecurePayload, writeSecurePayload, clearSecurePayload } from './secure-storage.uts'

export type StoredSession = {
  refreshToken: string, issuer: string, clientId: string, userId: string, tenantId: string
}

function namespace(): string {
  return 'com.rigour.workbench|__UNI__EE5460C|' + appEnvironment.environment
    + '|' + appEnvironment.issuer + '|' + appEnvironment.clientId
}
function validSession(value: StoredSession, issuer: string, clientId: string): boolean {
  return value.refreshToken.length > 0 && value.issuer == issuer && value.clientId == clientId
    && value.userId.length > 0 && value.tenantId.length > 0
}
export function secureSessionSupported(): boolean { return secureStorageSupported() }
export function readSecureSession(success: (value: StoredSession | null) => void, fail: (message: string) => void): void {
  const issuer = appEnvironment.issuer; const clientId = appEnvironment.clientId
  readSecurePayload(namespace(), (raw: string | null) => {
    if (raw == null) { success(null); return }
    try {
      const body = JSON.parseObject(raw!)
      if (body == null) throw new Error('invalid secure payload')
      const value: StoredSession = { refreshToken: body.getString('refreshToken') ?? '', issuer: body.getString('issuer') ?? '', clientId: body.getString('clientId') ?? '', userId: body.getString('userId') ?? '', tenantId: body.getString('tenantId') ?? '' }
      if (!validSession(value, issuer, clientId)) throw new Error('invalid secure identity')
      success(value)
    } catch (_) { fail('已保存的登录信息无法通过安全校验，请重新登录。') }
  }, (_message: string) => { fail('已保存的登录信息无法通过安全校验，请重新登录。') })
}
export function writeSecureSession(value: StoredSession, success: () => void, fail: (message: string) => void): void {
  if (!validSession(value, appEnvironment.issuer, appEnvironment.clientId)) {
    setTimeout(() => { fail('无法安全保存登录信息，请重新登录。') }, 0); return
  }
  writeSecurePayload(namespace(), JSON.stringify(value), success, (_message: string) => { fail('无法安全保存登录信息，请重新登录。') })
}
export function clearSecureSession(success: () => void, fail: (message: string) => void): void {
  clearSecurePayload(namespace(), success, (_message: string) => { fail('无法完全清除已保存的登录信息，请重试退出登录。') })
}
