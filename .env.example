# 浏览器请求使用相对路径；Vite服务端把/api代理到下面的Gateway地址。
# 本机开发默认localhost，换服务器时只修改这里，不要把服务器IP写进vite.config.ts。
VITE_API_BASE_URL=/api/v1
VITE_API_TARGET=http://localhost:26880
# true仅用于没有后端的本地演示；联调和生产必须为false，走真实API。
VITE_ENABLE_MOCK=true
VITE_DEFAULT_TENANT_ID=demo
VITE_APP_ENV=local
VITE_AUTH_MODE=mock
VITE_WORKBENCH_APPLICATION_CODE=FEISHU_SALES
VITE_REQUIRE_LOCATION_ON_BOOT=true
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=com.rigour.workbench://auth/callback
VITE_OIDC_SCOPE=openid profile
VITE_FEISHU_APP_ID=
VITE_FEISHU_MOCK=true
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
